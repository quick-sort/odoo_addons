<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!--
        arXiv 专用子通道（ADR-012）。

        arXiv 建议约 3 秒一次请求，而限速是**按来源方**计的：会存在多个 arXiv 源
        （cs.LG、cs.CV、math.AP……），它们是独立的源记录，identity_key 只保证同一个源
        不并发，无法阻止多个 arXiv 源同时出网并合计超速。

        把该来源方的全部任务派到这个子通道，并在部署时把容量配成 1，就把它们串成了
        一条队列。

        !!! 通道容量不是数据库字段，而是 odoo.conf 配置 !!!

            [queue_job]
            channels = root:4,root.infohub:2,root.infohub.arxiv:1

        漏配不会报错，但限速会静默失效，可能导致来源方封禁 IP。
    -->
    <record id="channel_arxiv" model="queue.job.channel">
        <field name="name">arxiv</field>
        <field name="parent_id" ref="infohub.channel_infohub" />
    </record>

</odoo>
