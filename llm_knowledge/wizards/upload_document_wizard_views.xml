<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_llm_upload_document_wizard_form" model="ir.ui.view">
        <field name="name">llm.upload.document.wizard.form</field>
        <field name="model">llm.upload.document.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload RAG Documents">
                <field name="state" invisible="1" />
                <sheet>
                    <div invisible="state != 'confirm'">
                        <div class="alert alert-info" role="alert">Upload local files and/or URLs into one collection. URL retrieval requires a collection cache backend.</div>
                        <group><field name="collection_id" options="{'no_create': True}" /><field name="document_name_template" /></group>
                        <notebook>
                            <page string="Local Files"><field name="file_ids" widget="many2many_binary" nolabel="1" /></page>
                            <page string="External URLs"><field name="external_urls" placeholder="One HTTP/HTTPS URL per line" nolabel="1" /></page>
                        </notebook>
                        <group><field name="process_immediately" /></group>
                    </div>
                    <div invisible="state != 'done'">
                        <div class="alert alert-success" role="alert">Created <field name="created_count" /> documents.</div>
                        <field name="created_document_ids" nolabel="1" readonly="1">
                            <list><field name="name" /><field name="collection_id" /><field name="source_type" /><field name="filename" /><field name="state" /></list>
                        </field>
                    </div>
                </sheet>
                <footer>
                    <button name="action_upload_documents" string="Upload Documents" type="object" class="btn-primary" invisible="state == 'done'" />
                    <button name="action_view_documents" string="View Documents" type="object" class="btn-primary" invisible="state == 'confirm'" />
                    <button special="cancel" string="Close" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
