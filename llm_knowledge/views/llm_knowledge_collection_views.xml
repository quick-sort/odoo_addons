<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_llm_knowledge_collection_form" model="ir.ui.view">
        <field name="name">llm.knowledge.collection.form</field>
        <field name="model">llm.knowledge.collection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="scan_storage" string="Scan Storage" type="object" class="btn-primary" invisible="not source_backend_id" confirm="Scan source storage and create documents for new files?" />
                    <button name="action_open_upload_wizard" string="Upload Documents" type="object" class="btn-primary" />
                    <button name="process_documents" string="Process Documents" type="object" class="btn-primary" confirm="Process documents through retrieval and Markdown extraction?" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file-text">
                            <field name="document_count" widget="statinfo" string="Documents" />
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Collection Name" /></h1></div>
                    <group>
                        <group>
                            <field name="active" widget="boolean_toggle" />
                            <field name="cache_backend_id" options="{'no_create': True}" />
                        </group>
                        <group>
                            <field name="source_backend_id" options="{'no_create': True}" />
                            <field name="source_path" invisible="not source_backend_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description"><field name="description" nolabel="1" /></page>
                        <page string="Documents">
                            <field name="document_ids" nolabel="1" context="{'default_collection_id': id}">
                                <list>
                                    <field name="name" />
                                    <field name="source_type" />
                                    <field name="filename" optional="show" />
                                    <field name="mimetype" optional="show" />
                                    <field name="state" />
                                    <button name="process_document" string="Process" type="object" icon="fa-cogs" />
                                    <button name="action_open_document" string="View" type="object" icon="fa-external-link" />
                                </list>
                            </field>
                        </page>
                        <page string="Extractor Mappings">
                            <field name="extractor_mapping_ids" context="{'default_collection_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="mimetype" />
                                    <field name="extension" />
                                    <field name="extractor_id" options="{'no_create': True}" />
                                    <field name="active" widget="boolean_toggle" />
                                </list>
                            </field>
                            <div class="alert alert-info mt-3" role="alert">
                                Collection mappings override global mappings. Within a scope the priority is exact MIME, exact extension, MIME wildcard, then a blank default mapping.
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_llm_knowledge_collection_tree" model="ir.ui.view">
        <field name="name">llm.knowledge.collection.list</field>
        <field name="model">llm.knowledge.collection</field>
        <field name="arch" type="xml">
            <list><field name="name" /><field name="document_count" /><field name="cache_backend_id" optional="show" /><field name="active" widget="boolean_toggle" /></list>
        </field>
    </record>

    <record id="view_llm_knowledge_collection_search" model="ir.ui.view">
        <field name="name">llm.knowledge.collection.search</field>
        <field name="model">llm.knowledge.collection</field>
        <field name="arch" type="xml"><search><field name="name" /><filter string="Archived" name="inactive" domain="[('active', '=', False)]" /></search></field>
    </record>

    <record id="view_llm_knowledge_collection_kanban" model="ir.ui.view">
        <field name="name">llm.knowledge.collection.kanban</field>
        <field name="model">llm.knowledge.collection</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" /><field name="document_count" />
                <templates><t t-name="card"><div class="oe_kanban_global_click"><strong><field name="name" /></strong><div><field name="document_count" /> documents</div></div></t></templates>
            </kanban>
        </field>
    </record>

    <record id="action_llm_knowledge_collection" model="ir.actions.act_window">
        <field name="name">Collections</field><field name="res_model">llm.knowledge.collection</field><field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
