<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_llm_store_chunk_tree" model="ir.ui.view">
        <field name="name">llm.store.chunk.list</field><field name="model">llm.store.chunk</field>
        <field name="arch" type="xml"><list><field name="name" /><field name="document_id" /><field name="collection_id" /><field name="chunkset_id" /><field name="sequence" widget="handle" /></list></field>
    </record>
    <record id="view_llm_store_chunk_form" model="ir.ui.view">
        <field name="name">llm.store.chunk.form</field><field name="model">llm.store.chunk</field>
        <field name="arch" type="xml"><form><sheet><group><field name="document_id" /><field name="collection_id" readonly="1" /><field name="chunkset_id" /><field name="sequence" /><field name="content" readonly="1" invisible="not content" /><field name="metadata" widget="json_widget" /></group></sheet></form></field>
    </record>
    <record id="view_llm_store_chunk_search" model="ir.ui.view">
        <field name="name">llm.store.chunk.search</field><field name="model">llm.store.chunk</field>
        <field name="arch" type="xml"><search><field name="embedding" /><field name="name" /><field name="document_id" /><field name="collection_id" /><field name="chunkset_id" /><filter string="High Similarity (0.75)" name="similarity_high" context="{'search_min_similarity': 0.75}" /><filter string="Medium Similarity (0.5)" name="similarity_medium" context="{'search_min_similarity': 0.5}" /><filter string="Low Similarity (0.25)" name="similarity_low" context="{'search_min_similarity': 0.25}" /></search></field>
    </record>
    <record id="view_llm_store_chunk_detail_form" model="ir.ui.view">
        <field name="name">llm.store.chunk.detail.form</field><field name="model">llm.store.chunk</field><field name="priority">20</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name" readonly="1" /><field name="document_id" readonly="1" /><field name="collection_id" readonly="1" /><field name="chunkset_id" readonly="1" /><field name="sequence" readonly="1" /></group><group string="Content" invisible="not content"><field name="content" readonly="1" nolabel="1" /></group><group string="Metadata" invisible="not metadata"><field name="metadata" widget="json_widget" readonly="1" nolabel="1" /></group></sheet></form></field>
    </record>
    <record id="action_llm_store_chunk" model="ir.actions.act_window">
        <field name="name">Store Chunks</field><field name="res_model">llm.store.chunk</field><field name="view_mode">list,form</field><field name="context">{'search_default_similarity_medium': 1}</field>
    </record>
</odoo>
