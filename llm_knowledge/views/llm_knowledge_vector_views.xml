<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_llm_knowledge_vector_form" model="ir.ui.view">
        <field name="name">llm.knowledge.vector.form</field>
        <field name="model">llm.knowledge.vector</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_build" string="Build Database" type="object" class="oe_highlight" />
                    <button name="action_drop" string="Drop Provider Scope" type="object" class="btn-secondary" confirm="This deletes the provider resource or isolated tenant scope owned by this build. Continue?" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" /></h1></div>
                    <group>
                        <group>
                            <field name="database_id" options="{'no_create': True}" />
                            <field name="collection_id" />
                            <field name="chunkset_id" />
                            <field name="dense_embedding_model_id" />
                            <field name="sparse_embedding_model_id" />
                        </group>
                        <group>
                            <field name="store_id" />
                            <field name="dimension" />
                            <field name="vector_count" />
                            <field name="active" />
                        </group>
                    </group>
                    <group string="Description"><field name="description" nolabel="1" /></group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_llm_knowledge_vector_tree" model="ir.ui.view">
        <field name="name">llm.knowledge.vector.tree</field>
        <field name="model">llm.knowledge.vector</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="database_id" />
                <field name="collection_id" />
                <field name="chunkset_id" />
                <field name="dense_embedding_model_id" />
                <field name="sparse_embedding_model_id" />
                <field name="store_id" />
                <field name="dimension" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="action_llm_knowledge_vector" model="ir.actions.act_window">
        <field name="name">Database Builds</field>
        <field name="res_model">llm.knowledge.vector</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
