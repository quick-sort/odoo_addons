<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_llm_store_database_record_form" model="ir.ui.view">
        <field name="name">llm.store.database.record.form</field>
        <field name="model">llm.store.database.record</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name" /></h1></div>
                    <group>
                        <group string="Ownership">
                            <field name="database_id" />
                            <field name="chunk_id" />
                            <field name="active" />
                            <field name="synced_once" />
                            <field name="state" />
                        </group>
                        <group string="Identity">
                            <field name="logical_id" />
                            <field name="backend_id" />
                            <field name="content_checksum" />
                            <field name="payload_checksum" />
                        </group>
                    </group>
                    <group string="Provider Metadata">
                        <field name="provider_metadata" widget="json_inline" />
                    </group>
                    <group string="Last Error" invisible="not last_error">
                        <field name="last_error" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_llm_store_database_record_tree" model="ir.ui.view">
        <field name="name">llm.store.database.record.list</field>
        <field name="model">llm.store.database.record</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="database_id" />
                <field name="chunk_id" />
                <field name="logical_id" />
                <field name="backend_id" />
                <field name="state" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="view_llm_store_database_record_search" model="ir.ui.view">
        <field name="name">llm.store.database.record.search</field>
        <field name="model">llm.store.database.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="logical_id" />
                <field name="backend_id" />
                <field name="database_id" />
                <field name="chunk_id" />
                <filter string="Database" name="group_by_database" context="{'group_by': 'database_id'}" />
                <filter string="State" name="group_by_state" context="{'group_by': 'state'}" />
            </search>
        </field>
    </record>

    <record id="action_llm_store_database_record" model="ir.actions.act_window">
        <field name="name">Provider Records</field>
        <field name="res_model">llm.store.database.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
