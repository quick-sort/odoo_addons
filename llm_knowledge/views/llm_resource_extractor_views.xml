<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_llm_resource_extractor_form" model="ir.ui.view">
        <field name="name">llm.resource.extractor.form</field>
        <field name="model">llm.resource.extractor</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_test_config"
                        string="Test Configuration"
                        type="object"
                        class="oe_highlight"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Extractor Name" /></h1>
                    </div>
                    <group>
                        <field name="extractor_type" />
                        <field name="active" widget="boolean_toggle" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_llm_resource_extractor_tree" model="ir.ui.view">
        <field name="name">llm.resource.extractor.tree</field>
        <field name="model">llm.resource.extractor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="extractor_type" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="action_llm_resource_extractor" model="ir.actions.act_window">
        <field name="name">Extractors</field>
        <field name="res_model">llm.resource.extractor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
