<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_llm_store_database_query_form" model="ir.ui.view">
        <field name="name">llm.store.database.query.form</field>
        <field name="model">llm.store.database.query</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" /></h1></div>
                    <group>
                        <group string="Query">
                            <field name="database_id" />
                            <field name="query_mode" />
                            <field name="is_default" />
                            <field name="active" />
                        </group>
                        <group string="Hybrid Channels" invisible="query_mode != 'hybrid'">
                            <field name="hybrid_bm25" />
                            <field name="hybrid_dense" />
                            <field name="hybrid_sparse" />
                            <field name="fusion_execution" />
                            <field name="fusion_method" />
                            <field name="bm25_weight" invisible="fusion_method != 'weighted' or not hybrid_bm25" />
                            <field name="dense_weight" invisible="fusion_method != 'weighted' or not hybrid_dense" />
                            <field name="sparse_weight" invisible="fusion_method != 'weighted' or not hybrid_sparse" />
                        </group>
                        <group string="Reranking">
                            <field name="rerank_execution" />
                            <field name="rerank_model_id" invisible="rerank_execution != 'client'" />
                        </group>
                    </group>
                    <group string="Query Settings">
                        <field name="settings" widget="json_inline" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_llm_store_database_query_tree" model="ir.ui.view">
        <field name="name">llm.store.database.query.list</field>
        <field name="model">llm.store.database.query</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="database_id" />
                <field name="query_mode" />
                <field name="fusion_execution" optional="show" />
                <field name="fusion_method" optional="show" />
                <field name="rerank_execution" />
                <field name="is_default" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="action_llm_store_database_query" model="ir.actions.act_window">
        <field name="name">Database Query Interfaces</field>
        <field name="res_model">llm.store.database.query</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
