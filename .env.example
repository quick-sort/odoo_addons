# Copy to .env (gitignored) and fill in. Generate with: openssl rand -hex 24

# Postgres password for user `odoo`. Used by both the db service and odoo.
POSTGRES_PASSWORD=

# Odoo master password for the service=db RPC (create/drop/restore).
# odoo.conf stores only its hash (admin_passwd); this records the plaintext.
# Rotate both with the crypt_context.hash command shown in odoo.conf.
ODOO_ADMIN_PASSWD=
