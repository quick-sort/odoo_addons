<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_llm_knowledge_chunk_embedding_tree" model="ir.ui.view">
        <field name="name">llm.knowledge.chunk.embedding.list</field><field name="model">llm.knowledge.chunk.embedding</field>
        <field name="arch" type="xml"><list><field name="chunk_id" /><field name="vector_id" /><field name="embedding_model_id" /><field name="document_id" /><field name="collection_id" /></list></field>
    </record>
    <record id="view_llm_knowledge_chunk_embedding_form" model="ir.ui.view">
        <field name="name">llm.knowledge.chunk.embedding.form</field><field name="model">llm.knowledge.chunk.embedding</field>
        <field name="arch" type="xml"><form><sheet><group><field name="chunk_id" /><field name="vector_id" /><field name="embedding_model_id" options="{'no_create': True}" /><field name="document_id" readonly="1" /><field name="collection_id" readonly="1" /></group><group string="Payload"><field name="content" readonly="1" /><field name="metadata" readonly="1" /></group><group string="Embedding Data"><field name="embedding" readonly="1" /></group></sheet></form></field>
    </record>
    <record id="view_llm_knowledge_chunk_embedding_search" model="ir.ui.view">
        <field name="name">llm.knowledge.chunk.embedding.search</field><field name="model">llm.knowledge.chunk.embedding</field>
        <field name="arch" type="xml"><search><field name="chunk_id" /><field name="vector_id" /><field name="embedding_model_id" /><field name="document_id" /><field name="collection_id" /><filter string="Vector" name="group_by_vector" domain="[]" context="{'group_by':'vector_id'}" /><filter string="Embedding Model" name="group_by_model" domain="[]" context="{'group_by':'embedding_model_id'}" /><filter string="Document" name="group_by_document" domain="[]" context="{'group_by':'document_id'}" /></search></field>
    </record>
    <record id="action_llm_knowledge_chunk_embedding" model="ir.actions.act_window">
        <field name="name">Chunk Embeddings</field><field name="res_model">llm.knowledge.chunk.embedding</field><field name="view_mode">list,form</field>
    </record>
</odoo>
