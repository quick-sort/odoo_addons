<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!--
        条目详情。正文是第三方 HTML，字段侧已 sanitize，输出侧一律 t-out。
        上一条/下一条由 portal.portal_layout 根据 prev_record / next_record 渲染，
        这两个值来自控制器的 _get_page_view_values(..., 'infohub_timeline_history')。
    -->

    <template id="portal_item" name="InfoHub: 条目详情">
        <t t-call="portal.portal_layout">
            <div class="o_infohub_item">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                    <h3 class="mb-0" t-out="item.title" />
                    <div class="d-flex gap-1 flex-shrink-0">
                        <button
                            type="button"
                            t-attf-class="btn btn-sm btn-outline-secondary o_infohub_star #{'o_infohub_starred' if read_state and read_state.is_starred else ''}"
                            t-att-data-item-id="item.id"
                            title="收藏"
                        >
                            <i class="fa fa-star" />
                        </button>
                        <a
                            t-if="item.url"
                            t-att-href="item.url"
                            target="_blank"
                            rel="noreferrer noopener"
                            class="btn btn-sm btn-primary"
                        >
                            <i class="fa fa-external-link me-1" />读原文
                        </a>
                    </div>
                </div>

                <div class="text-muted small mb-3">
                    <span t-out="item.source_id.name" />
                    <t t-if="item.author_name">
                        · <span t-out="item.author_name" />
                    </t>
                    <t t-if="item.published_at">
                        · <span t-out="item.published_at" t-options="{'widget': 'datetime'}" />
                    </t>
                    <t t-if="item.lang">
                        · <span t-out="item.lang" />
                    </t>
                </div>

                <div class="mb-3 d-flex flex-wrap gap-1">
                    <a
                        t-foreach="item.topic_ids"
                        t-as="topic"
                        t-attf-href="/infohub?topic_id=#{topic.id}"
                        class="badge text-bg-light text-decoration-none"
                        t-out="topic.name"
                    />
                    <span
                        t-foreach="item.tag_ids"
                        t-as="tag"
                        class="badge text-bg-secondary"
                        t-out="tag.name"
                    />
                </div>

                <!-- 有正文就显示正文；只有摘要时显示摘要并提示去读原文 -->
                <div t-if="item.content" class="o_infohub_content">
                    <t t-out="item.content" />
                </div>
                <div t-elif="item.summary" class="o_infohub_content">
                    <t t-out="item.summary" />
                    <div class="alert alert-light mt-3" role="alert">
                        本条只提供了摘要。
                        <a t-if="item.url" t-att-href="item.url" target="_blank" rel="noreferrer noopener">
                            前往原文阅读全文
                        </a>
                    </div>
                </div>
                <div t-else="" class="alert alert-light" role="alert">
                    本条没有正文内容。
                    <a t-if="item.url" t-att-href="item.url" target="_blank" rel="noreferrer noopener">
                        前往原文
                    </a>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-between">
                    <a href="/infohub" class="btn btn-sm btn-light">
                        <i class="fa fa-arrow-left me-1" />返回信息流
                    </a>
                    <button
                        type="button"
                        class="btn btn-sm btn-light o_infohub_unread"
                        t-att-data-item-id="item.id"
                    >
                        标为未读
                    </button>
                </div>
            </div>
        </t>
    </template>

</odoo>
