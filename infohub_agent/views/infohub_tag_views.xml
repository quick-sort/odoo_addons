<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_infohub_tag_list" model="ir.ui.view">
        <field name="name">infohub.tag.list</field>
        <field name="model">infohub.tag</field>
        <field name="arch" type="xml">
            <list string="Tags">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="item_count" />
                <field name="color" invisible="1" />
            </list>
        </field>
    </record>

    <record id="view_infohub_tag_form" model="ir.ui.view">
        <field name="name">infohub.tag.form</field>
        <field name="model">infohub.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_items"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-newspaper-o"
                        >
                            <field name="item_count" widget="statinfo" string="Items" />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Clinical" />
                            <field name="code" placeholder="e.g. clinical" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="color" widget="color_picker" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                    </group>
                    <group string="Prompt Guidance">
                        <field
                            name="description"
                            nolabel="1"
                            placeholder="When should the model apply this tag? This text is sent to the model verbatim."
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_infohub_tag_search" model="ir.ui.view">
        <field name="name">infohub.tag.search</field>
        <field name="model">infohub.tag</field>
        <field name="arch" type="xml">
            <search string="Tags">
                <field name="name" />
                <field name="code" />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="action_infohub_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">infohub.tag</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_infohub_tag_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your first tag</p>
            <p>
                Tags form the fixed taxonomy the InfoHub Tagger agent picks from.
                While this list is empty, items stay pending and no LLM call is made.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_infohub_tag"
        name="Tags"
        parent="infohub.menu_infohub_settings"
        action="action_infohub_tag"
        sequence="30"
    />
</odoo>
