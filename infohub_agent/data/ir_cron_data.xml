<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Dispatch only: the cron claims pending items and enqueues one job
         per batch (channel root.infohub, capacity in odoo.conf); the LLM
         call itself never runs in the scheduler. -->
    <record id="ir_cron_infohub_tagging" model="ir.cron">
        <field name="name">InfoHub: Enqueue item tagging batches</field>
        <field name="model_id" ref="infohub.model_infohub_item" />
        <field name="state">code</field>
        <field name="code">model._cron_enqueue_tagging()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
