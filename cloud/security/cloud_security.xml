<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cloud" model="ir.module.category">
        <field name="name">云平台</field>
        <field name="sequence">60</field>
    </record>

    <record model="res.groups.privilege" id="privilege_cloud">
        <field name="name">云平台</field>
        <field name="category_id" ref="module_category_cloud"/>
    </record>

    <record id="group_cloud_user" model="res.groups">
        <field name="name">云平台用户</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="privilege_cloud"/>
    </record>

    <record id="group_cloud_manager" model="res.groups">
        <field name="name">云平台管理员</field>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_cloud_user'))]"/>
        <field name="privilege_id" ref="privilege_cloud"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
