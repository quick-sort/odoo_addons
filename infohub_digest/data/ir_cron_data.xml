<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!--
        每天跑一次就够：每日与每周摘要都在同一个 cron 里处理，
        infohub.digest.log.already_sent() 保证同一周期内不会重复发送，
        所以 cron 多跑几次也无害（重跑安全）。
    -->
    <record id="cron_send_digests" model="ir.cron">
        <field name="name">InfoHub：发送摘要邮件</field>
        <field name="model_id" ref="base.model_res_users" />
        <field name="state">code</field>
        <field name="code">model._cron_infohub_send_digests()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="priority">8</field>
        <field name="active" eval="True" />
    </record>

    <record id="cron_gc_digest_logs" model="ir.cron">
        <field name="name">InfoHub：清理过期摘要记录</field>
        <field name="model_id" ref="model_infohub_digest_log" />
        <field name="state">code</field>
        <field name="code">model._gc_logs()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="priority">9</field>
        <field name="active" eval="True" />
    </record>

</odoo>
