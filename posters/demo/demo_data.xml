        <field name="storage_options">{"key": "AKIAIOSFODNN7EXAMPLE", "secret": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY", "client_kwargs": {"region_name": "us-east-1"}}</field>
    </record>

