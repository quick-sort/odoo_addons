    <record id="storage_local" model="poster.storage">
        <field name="name">Local File Storage</field>
        <field name="protocol">file</field>
        <field name="path_prefix">/mnt/posters</field>
        <field name="storage_options">{}</field>
    </record>

    <record id="storage_s3" model="poster.storage">
        <field name="name">S3 Poster Bucket</field>
        <field name="protocol">s3</field>
