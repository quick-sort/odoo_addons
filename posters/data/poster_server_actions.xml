<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="action_poster_download_zip" model="ir.actions.server">
        <field name="name">Download ZIP</field>
        <field name="model_id" ref="model_conference_poster"/>
        <field name="binding_model_id" ref="model_conference_poster"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_download_zip()</field>
    </record>

    <record id="action_collection_import_metadata" model="ir.actions.server">
        <field name="name">Import Metadata</field>
        <field name="model_id" ref="model_conference_conference"/>
        <field name="binding_model_id" ref="model_conference_conference"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = record.action_import_metadata()</field>
    </record>

</odoo>
