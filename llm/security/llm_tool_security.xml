<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Regular users only see tools whose allowed groups intersect theirs.
         A tool with no allowed groups is therefore admin-only. Group rules are
         OR-ed together, so the permissive rule below gives administrators
         every tool. -->
    <record id="llm_tool_rule_allowed_groups" model="ir.rule">
        <field name="name">LLM Tools: allowed groups only</field>
        <field name="model_id" ref="model_llm_tool"/>
        <field name="domain_force">[('allowed_group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="llm_tool_rule_admin" model="ir.rule">
        <field name="name">LLM Tools: all tools for administrators</field>
        <field name="model_id" ref="model_llm_tool"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
