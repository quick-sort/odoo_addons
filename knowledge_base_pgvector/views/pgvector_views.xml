<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_knowledge_vector_store_form_pgvector" model="ir.ui.view">
        <field name="name">knowledge.vector.store.form.pgvector</field>
        <field name="model">knowledge.vector.store</field>
        <field name="inherit_id" ref="knowledge_base_vector_store.view_knowledge_vector_store_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="PostgreSQL / pgvector"
                      invisible="vector_store_type != 'pgvector'">
                    <group>
                        <group>
                            <field name="host"/>
                            <field name="port"/>
                            <field name="database"/>
                        </group>
                        <group>
                            <field name="username"/>
                            <field name="password" password="True"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
