<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Configure capacity in odoo.conf, for example:
         [queue_job]
         channels = root:4,root.async_task:2
    -->
    <record id="channel_async_task" model="queue.job.channel">
        <field name="name">async_task</field>
        <field name="parent_id" ref="queue_job.channel_root" />
    </record>

    <record id="job_function_async_task_submit" model="queue.job.function">
        <field name="model_id" ref="model_async_task" />
        <field name="method">_job_submit</field>
        <field name="channel_id" ref="channel_async_task" />
        <field name="retry_pattern" eval="{1: 10, 3: 60, 5: 300}" />
    </record>

    <record id="job_function_async_task_execute_submit" model="queue.job.function">
        <field name="model_id" ref="model_async_task" />
        <field name="method">_job_execute_submit</field>
        <field name="channel_id" ref="channel_async_task" />
        <field name="retry_pattern" eval="{1: 10, 3: 60, 5: 300}" />
    </record>

    <record id="job_function_async_task_poll" model="queue.job.function">
        <field name="model_id" ref="model_async_task" />
        <field name="method">_job_poll</field>
        <field name="channel_id" ref="channel_async_task" />
        <field name="retry_pattern" eval="{1: 10, 3: 60, 5: 300}" />
    </record>

    <record id="job_function_async_task_execute_poll" model="queue.job.function">
        <field name="model_id" ref="model_async_task" />
        <field name="method">_job_execute_poll</field>
        <field name="channel_id" ref="channel_async_task" />
        <field name="retry_pattern" eval="{1: 10, 3: 60, 5: 300}" />
    </record>

    <record id="job_function_async_task_cancel" model="queue.job.function">
        <field name="model_id" ref="model_async_task" />
        <field name="method">_job_cancel</field>
        <field name="channel_id" ref="channel_async_task" />
        <field name="retry_pattern" eval="{1: 10, 3: 60, 5: 300}" />
    </record>

    <record id="job_function_async_task_webhook" model="queue.job.function">
        <field name="model_id" ref="model_async_task_event" />
        <field name="method">_job_process</field>
        <field name="channel_id" ref="channel_async_task" />
        <field name="retry_pattern" eval="{1: 10, 3: 60, 5: 300}" />
    </record>
</odoo>
