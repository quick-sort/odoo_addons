<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_microsoft_graph_application_list" model="ir.ui.view">
        <field name="name">microsoft.graph.application.list</field>
        <field name="model">microsoft.graph.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="graph_tenant_id" />
                <field name="graph_client_id" />
                <field name="graph_scope" />
                <field name="allow_user_authorization" />
            </list>
        </field>
    </record>

    <record id="view_microsoft_graph_application_form" model="ir.ui.view">
        <field name="name">microsoft.graph.application.form</field>
        <field name="model">microsoft.graph.application</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="graph_current_user_authorized" invisible="1" />
                    <button
                        type="object"
                        name="action_graph_authorize"
                        string="Connect Microsoft Account"
                        icon="fa-sign-in"
                        class="btn-primary"
                    />
                    <button
                        type="object"
                        name="action_graph_disconnect"
                        string="Disconnect Microsoft Account"
                        icon="fa-sign-out"
                        invisible="not graph_current_user_authorized"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="e.g. Contoso Graph App" />
                        </h1>
                    </div>
                    <group>
                        <group name="app" string="Entra Application">
                            <field name="graph_tenant_id" required="1" />
                            <field name="graph_client_id" required="1" />
                            <field name="graph_client_secret" password="True" />
                            <field name="graph_scope" required="1" />
                            <field name="allow_user_authorization" />
                        </group>
                        <group name="status" string="Status">
                            <field
                                name="graph_current_user_authorized"
                                readonly="1"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="User Credentials">
                            <field name="credential_ids" readonly="1">
                                <list>
                                    <field name="user_id" />
                                    <field name="entra_oid" />
                                    <field name="token_expiry" />
                                    <field name="granted_scope" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_microsoft_graph_application" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">microsoft.graph.application</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
