<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!-- No api_key on purpose: demo data must never suggest a working
         credential. Users add their own key before testing connectivity. -->

    <record id="llm_provider_openai_demo" model="llm.provider">
        <field name="name">OpenAI (Demo)</field>
        <field name="service">openai</field>
        <field name="api_base">https://api.openai.com/v1</field>
    </record>

    <record id="llm_model_gpt_4o_demo" model="llm.model">
        <field name="name">gpt-4o</field>
        <field name="provider_id" ref="llm_provider_openai_demo" />
        <field name="publisher_id" ref="llm_openai.llm_publisher_openai" />
        <field name="model_use">chat</field>
        <field name="supports_image_input">True</field>
    </record>

    <record id="llm_model_text_embedding_3_small_demo" model="llm.model">
        <field name="name">text-embedding-3-small</field>
        <field name="provider_id" ref="llm_provider_openai_demo" />
        <field name="publisher_id" ref="llm_openai.llm_publisher_openai" />
        <field name="model_use">embedding</field>
    </record>

</odoo>
