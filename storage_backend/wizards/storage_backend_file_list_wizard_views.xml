<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="storage_backend_file_list_wizard_view_form" model="ir.ui.view">
        <field name="name">storage.backend.file.list.wizard.form</field>
        <field name="model">storage.backend.file.list.wizard</field>
        <field name="arch" type="xml">
            <form string="Manage Files">
                <field name="has_more" invisible="1" />
                <sheet>
                    <group>
                        <group>
                            <field name="backend_id" readonly="1" />
                            <field name="backend_type" readonly="1" />
                            <field name="directory_path" readonly="1" />
                            <field name="subpath" />
                            <field name="limit" />
                        </group>
                        <group>
                            <field name="file_count" readonly="1" />
                        </group>
                    </group>
                    <div
                        class="alert alert-warning text-center"
                        role="alert"
                        invisible="has_more == False"
                    >
                        Only the first
                        <field name="limit" readonly="1" class="oe_inline" />
                        files are shown. Increase the limit to load more.
                    </div>
                    <notebook>
                        <page string="Files">
                            <div class="o_form_statusbar_buttons mb-2">
                                <button
                                    type="object"
                                    name="action_list_files"
                                    string="Refresh"
                                    class="btn-primary"
                                    icon="fa-refresh"
                                />
                            </div>
                            <field name="line_ids" colspan="4" nolabel="1">
                                <list create="false" delete="false">
                                    <field
                                        name="is_directory"
                                        readonly="1"
                                        icon="fa-folder"
                                        invisible="1"
                                    />
                                    <field
                                        name="name"
                                        readonly="1"
                                        decoration-bf="is_directory"
                                        decoration-info="is_directory"
                                    />
                                    <field name="relative_path" readonly="1" />
                                    <button
                                        name="action_download"
                                        type="object"
                                        icon="fa-download"
                                        title="Download"
                                        invisible="is_directory"
                                    />
                                    <button
                                        name="action_delete"
                                        type="object"
                                        icon="fa-trash-o"
                                        title="Delete"
                                        confirm="Delete this file?"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="Upload">
                            <group>
                                <group>
                                    <field name="upload_path" />
                                </group>
                                <group>
                                    <field
                                        name="file_data"
                                        filename="filename"
                                    />
                                    <field name="filename" invisible="1" />
                                </group>
                            </group>
                            <div class="mt-3">
                                <button
                                    type="object"
                                    name="action_upload"
                                    string="Upload"
                                    class="btn-primary"
                                    icon="fa-upload"
                                />
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button
                        string="Close"
                        special="cancel"
                        class="btn-secondary"
                        data-hotkey="z"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="action_storage_backend_file_list_wizard"
        model="ir.actions.act_window"
    >
        <field name="name">Manage Files</field>
        <field name="res_model">storage.backend.file.list.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_storage_backend" />
        <field name="context">{'default_backend_id': active_id}</field>
    </record>
</odoo>
