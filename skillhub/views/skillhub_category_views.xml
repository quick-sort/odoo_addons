<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_skillhub_category_list" model="ir.ui.view">
        <field name="name">skillhub.category.list</field>
        <field name="model">skillhub.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="view_skillhub_category_form" model="ir.ui.view">
        <field name="name">skillhub.category.form</field>
        <field name="model">skillhub.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_skillhub_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">skillhub.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
