<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_groups_privilege_skillhub" model="res.groups.privilege">
        <field name="name">Skills Hub</field>
        <field name="sequence">86</field>
        <field name="category_id" ref="base.module_category_administration" />
    </record>

    <record id="group_skillhub_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Can publish, search and download skill packages.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_skillhub" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_skillhub_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Can manage every skill and category.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_skillhub" />
        <field name="implied_ids" eval="[(4, ref('group_skillhub_user'))]" />
    </record>

    <record id="skill_rule_read" model="ir.rule">
        <field name="name">Skill: read own, shared and public</field>
        <field name="model_id" ref="model_skillhub_skill" />
        <field name="domain_force">['|','|',('create_uid','=',user.id),('shared_user_ids','in',user.id),('is_public','=',True)]</field>
        <field name="perm_read" eval="True" />
        <field name="groups" eval="[(4, ref('group_skillhub_user'))]" />
    </record>

    <!-- Group rules are OR'ed, so this widens the read rule above for
         administrators without changing what regular users see. A skill is
         shared data an administrator has to be able to audit even when it is
         neither owned nor shared with them. -->
    <record id="skill_rule_admin" model="ir.rule">
        <field name="name">Skill: administrators have full access</field>
        <field name="model_id" ref="model_skillhub_skill" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="groups" eval="[(4, ref('group_skillhub_admin'))]" />
    </record>

    <record id="skill_rule_owner_write" model="ir.rule">
        <field name="name">Skill: write/delete only by owner</field>
        <field name="model_id" ref="model_skillhub_skill" />
        <field name="domain_force">[('create_uid','=',user.id)]</field>
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="groups" eval="[(4, ref('group_skillhub_user'))]" />
    </record>
</odoo>
