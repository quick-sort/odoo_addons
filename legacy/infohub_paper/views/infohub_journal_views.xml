<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_infohub_journal_list" model="ir.ui.view">
        <field name="name">infohub.journal.list</field>
        <field name="model">infohub.journal</field>
        <field name="arch" type="xml">
            <list string="期刊" editable="bottom">
                <field name="name" />
                <field name="issn" />
                <field name="publisher" />
                <field name="homepage" widget="url" optional="hide" />
                <field name="paper_count" string="论文数" readonly="1" />
            </list>
        </field>
    </record>

    <record id="view_infohub_journal_form" model="ir.ui.view">
        <field name="name">infohub.journal.form</field>
        <field name="model">infohub.journal</field>
        <field name="arch" type="xml">
            <form string="期刊">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="issn" />
                            <field name="publisher" />
                        </group>
                        <group>
                            <field name="homepage" widget="url" />
                            <field name="paper_count" />
                        </group>
                    </group>
                    <notebook>
                        <page string="论文" name="papers">
                            <field name="paper_ids" readonly="1">
                                <list>
                                    <field name="published_at" />
                                    <field name="title" />
                                    <field name="author_names" />
                                    <field name="doi" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_infohub_journal" model="ir.actions.act_window">
        <field name="name">期刊</field>
        <field name="res_model">infohub.journal</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
