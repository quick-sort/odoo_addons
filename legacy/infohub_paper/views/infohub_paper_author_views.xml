<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_infohub_paper_author_list" model="ir.ui.view">
        <field name="name">infohub.paper.author.list</field>
        <field name="model">infohub.paper.author</field>
        <field name="arch" type="xml">
            <list string="作者">
                <field name="name" />
                <field name="orcid" optional="show" />
                <field name="affiliation" optional="show" />
                <field name="paper_count" string="论文数" />
            </list>
        </field>
    </record>

    <record id="view_infohub_paper_author_form" model="ir.ui.view">
        <field name="name">infohub.paper.author.form</field>
        <field name="model">infohub.paper.author</field>
        <field name="arch" type="xml">
            <form string="作者">
                <header>
                    <button
                        name="action_view_papers"
                        type="object"
                        string="查看论文"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="orcid" placeholder="0000-0000-0000-0000" />
                            <field name="affiliation" />
                        </group>
                        <group>
                            <field name="name_normalized" readonly="1" />
                            <field name="paper_count" />
                        </group>
                    </group>
                    <div class="alert alert-light" role="alert">
                        作者去重只做保守的名称归一化（压缩空白、转小写），不做启发式合并——
                        把两位同名作者错并成一个人比不合并更糟。需要精确消歧请填 ORCID。
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_infohub_paper_author_search" model="ir.ui.view">
        <field name="name">infohub.paper.author.search</field>
        <field name="model">infohub.paper.author</field>
        <field name="arch" type="xml">
            <search string="作者">
                <field name="name" />
                <field name="orcid" />
                <field name="affiliation" />
                <filter name="filter_has_orcid" string="有 ORCID" domain="[('orcid', '!=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_infohub_paper_author" model="ir.actions.act_window">
        <field name="name">论文作者</field>
        <field name="res_model">infohub.paper.author</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
