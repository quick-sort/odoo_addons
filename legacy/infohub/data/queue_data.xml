<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!--
        InfoHub 的 queue_job 通道。抓取、增强等任务都走 root.infohub。

        需要全局限速的来源方（例如 arXiv 要求约 3 秒一次请求）应在本通道下再开
        子通道，并把容量配成 1，使该来源方的全部任务串成一条队列（ADR-012）。

        重要：**通道容量不是数据库字段，而是 odoo.conf 配置**，缺失则沿用默认
        root:1：

            [queue_job]
            channels = root:4,root.infohub.arxiv:1

        也可用环境变量 ODOO_QUEUE_JOB_CHANNELS 设置。漏配会导致限速静默失效。
    -->
    <record id="channel_infohub" model="queue.job.channel">
        <field name="name">infohub</field>
        <field name="parent_id" ref="queue_job.channel_root" />
    </record>

</odoo>
