<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!--
        凭证只对 infohub.group_manager 开放 ACL（N6）。这里不给 portal 或普通
        内部用户任何入口。
    -->

    <record id="view_infohub_credential_list" model="ir.ui.view">
        <field name="name">infohub.credential.list</field>
        <field name="model">infohub.credential</field>
        <field name="arch" type="xml">
            <list string="凭证">
                <field name="name" />
                <field name="auth_type" />
                <field name="source_count" string="使用的源" />
            </list>
        </field>
    </record>

    <record id="view_infohub_credential_form" model="ir.ui.view">
        <field name="name">infohub.credential.form</field>
        <field name="model">infohub.credential</field>
        <field name="arch" type="xml">
            <form string="凭证">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="auth_type" />
                            <field
                                name="api_key"
                                password="True"
                                invisible="auth_type not in ('api_key', 'bearer')"
                                required="auth_type in ('api_key', 'bearer')"
                            />
                            <field
                                name="header_name"
                                invisible="auth_type != 'api_key'"
                            />
                        </group>
                        <group>
                            <field
                                name="username"
                                invisible="auth_type != 'basic'"
                                required="auth_type == 'basic'"
                            />
                            <field
                                name="password"
                                password="True"
                                invisible="auth_type != 'basic'"
                            />
                        </group>
                    </group>
                    <field name="note" placeholder="备注：从哪里申请、额度限制、到期时间..." />
                    <notebook>
                        <page string="使用的源" name="sources">
                            <field name="source_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="provider" />
                                    <field name="active" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_infohub_credential" model="ir.actions.act_window">
        <field name="name">凭证</field>
        <field name="res_model">infohub.credential</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
