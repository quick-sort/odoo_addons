<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_infohub_source_run_list" model="ir.ui.view">
        <field name="name">infohub.source.run.list</field>
        <field name="model">infohub.source.run</field>
        <field name="arch" type="xml">
            <list string="抓取日志" decoration-danger="state == 'failed'" create="false">
                <field name="date_started" />
                <field name="source_id" />
                <field name="state" widget="badge" />
                <field name="duration" sum="总耗时" />
                <field name="item_found" sum="发现" />
                <field name="item_created" sum="新建" />
                <field name="item_skipped" sum="跳过" />
            </list>
        </field>
    </record>

    <record id="view_infohub_source_run_form" model="ir.ui.view">
        <field name="name">infohub.source.run.form</field>
        <field name="model">infohub.source.run</field>
        <field name="arch" type="xml">
            <form string="抓取日志" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="source_id" />
                            <field name="state" />
                            <field name="date_started" />
                            <field name="date_finished" />
                            <field name="duration" />
                        </group>
                        <group>
                            <field name="item_found" />
                            <field name="item_created" />
                            <field name="item_skipped" />
                        </group>
                    </group>
                    <separator string="错误" invisible="not error" />
                    <field name="error" readonly="1" invisible="not error" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_infohub_source_run_search" model="ir.ui.view">
        <field name="name">infohub.source.run.search</field>
        <field name="model">infohub.source.run</field>
        <field name="arch" type="xml">
            <search string="抓取日志">
                <field name="source_id" />
                <filter name="filter_failed" string="失败" domain="[('state', '=', 'failed')]" />
                <filter name="filter_running" string="进行中" domain="[('state', '=', 'running')]" />
                <group name="group_by">
                    <filter
                        name="group_by_source"
                        string="来源"
                        context="{'group_by': 'source_id'}"
                    />
                    <filter name="group_by_state" string="状态" context="{'group_by': 'state'}" />
                    <filter
                        name="group_by_day"
                        string="日期"
                        context="{'group_by': 'date_started:day'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_infohub_source_run" model="ir.actions.act_window">
        <field name="name">抓取日志</field>
        <field name="res_model">infohub.source.run</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_failed': 1}</field>
    </record>

</odoo>
