<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!--
        常见 RSS 分类名到核心学科的映射。

        RSS 的 <category> 是自由文本、没有受控编码，而学科词表用中文命名，两者
        对不上——没有这张映射表，classifier 开箱即完全不工作。

        provider 用 'rss' 而不是源的 provider（generic）：generic 会被其他传输
        共用，而这里的语义明确是"RSS 分类名 → 学科"。

        管理员可以在「配置 → 学科映射」里继续追加，无需改代码（R4.5）。
    -->

    <record id="mapping_technology" model="infohub.topic.mapping">
        <field name="provider">rss</field>
        <field name="external_code">Technology</field>
        <field name="external_name">Technology</field>
        <field name="topic_id" ref="infohub.topic_technology" />
    </record>
    <record id="mapping_tech" model="infohub.topic.mapping">
        <field name="provider">rss</field>
        <field name="external_code">Tech</field>
        <field name="topic_id" ref="infohub.topic_technology" />
    </record>
    <record id="mapping_software" model="infohub.topic.mapping">
        <field name="provider">rss</field>
        <field name="external_code">Software</field>
