<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_infohub_channel_form_email" model="ir.ui.view">
        <field name="name">infohub.channel.form.email</field>
        <field name="model">infohub.channel</field>
        <field name="inherit_id" ref="infohub.view_infohub_channel_form" />
        <field name="arch" type="xml">
            <field name="channel_type" position="after">
                <field
                    name="email_to"
                    placeholder="news@example.com"
                    invisible="channel_type != 'email'"
                    required="channel_type == 'email'"
                />
                <field
                    name="split_items"
                    invisible="channel_type != 'email'"
                />
            </field>
        </field>
    </record>
</odoo>
