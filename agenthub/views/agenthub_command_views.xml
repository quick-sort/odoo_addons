<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="agenthub_command_action" model="ir.actions.act_window">
        <field name="name">Commands</field>
        <field name="res_model">agenthub.command</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="agenthub_command_view_list" model="ir.ui.view">
        <field name="name">agenthub.command.list</field>
        <field name="model">agenthub.command</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="agent_id"/>
                <field name="thread_id"/>
                <field name="reply_mode"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="agenthub_command_view_form" model="ir.ui.view">
        <field name="name">agenthub.command.form</field>
        <field name="model">agenthub.command</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_queue"
                            type="object"
                            string="Queue"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="agent_id"/>
                            <field name="thread_id"/>
                        </group>
                        <group>
                            <field name="reply_mode"/>
                            <field name="state"/>
                            <field name="result_message_id"/>
                        </group>
                    </group>
                    <group string="Payload">
                        <field name="payload" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="agenthub_command_view_search" model="ir.ui.view">
        <field name="name">agenthub.command.search</field>
        <field name="model">agenthub.command</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="agent_id"/>
                <field name="state"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="queued" string="Queued" domain="[('state', '=', 'queued')]"/>
            </search>
        </field>
    </record>

    <menuitem id="menu_agenthub_command"
              name="Commands"
              parent="menu_agenthub_root"
              action="agenthub_command_action"
              sequence="40"/>

</odoo>
