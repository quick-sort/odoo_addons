<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="agenthub_binding_action" model="ir.actions.act_window">
        <field name="name">Bindings</field>
        <field name="res_model">agenthub.binding</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="agenthub_binding_view_list" model="ir.ui.view">
        <field name="name">agenthub.binding.list</field>
        <field name="model">agenthub.binding</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
                <field name="channel_id"/>
                <field name="agent_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="agenthub_binding_view_form" model="ir.ui.view">
        <field name="name">agenthub.binding.form</field>
        <field name="model">agenthub.binding</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="channel_id"/>
                        </group>
                        <group>
                            <field name="agent_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="agenthub_binding_view_search" model="ir.ui.view">
        <field name="name">agenthub.binding.search</field>
        <field name="model">agenthub.binding</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="channel_id"/>
                <field name="agent_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <menuitem id="menu_agenthub_binding"
              name="Bindings"
              parent="menu_agenthub_root"
              action="agenthub_binding_action"
              sequence="30"/>

</odoo>
