<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="agenthub_agent_action" model="ir.actions.act_window">
        <field name="name">Agents</field>
        <field name="res_model">agenthub.agent</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No agents yet.
            </p>
            <p>
                Register your external agent here: give it a name and the API key
                it presents over JSON-RPC to authenticate.
            </p>
        </field>
    </record>

    <record id="agenthub_agent_view_list" model="ir.ui.view">
        <field name="name">agenthub.agent.list</field>
        <field name="model">agenthub.agent</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="agent_type"/>
                <field name="user_id"/>
                <field name="owner_user_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="agenthub_agent_view_form" model="ir.ui.view">
        <field name="name">agenthub.agent.form</field>
        <field name="model">agenthub.agent</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Agent name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="agent_type"/>
                            <field name="api_key" widget="password"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="owner_user_id"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="agenthub_agent_view_search" model="ir.ui.view">
        <field name="name">agenthub.agent.search</field>
        <field name="model">agenthub.agent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="agent_type"/>
                <field name="user_id"/>
                <field name="owner_user_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <menuitem id="menu_agenthub_root"
              name="Agent Hub"
              sequence="80"/>
    <menuitem id="menu_agenthub_agent"
              name="Agents"
              parent="menu_agenthub_root"
              action="agenthub_agent_action"
              sequence="10"/>

</odoo>
