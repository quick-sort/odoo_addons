        <field name="model_id" ref="model_agenthub_turn"/>
        <field name="domain_force">[('thread_id.agent_id.owner_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="agenthub_turn_rule_all" model="ir.rule">
