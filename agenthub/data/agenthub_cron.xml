<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_agenthub_publish" model="ir.cron">
        <field name="name">Agent Hub: publish outbox</field>
        <field name="model_id" ref="model_agenthub_publish" />
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="priority">9</field>
        <field name="active" eval="True" />
    </record>
    <record id="ir_cron_agenthub_recorder" model="ir.cron">
        <field name="name">Agent Hub: pull relay record feed</field>
        <field name="model_id" ref="model_agenthub_record_cursor" />
        <field name="state">code</field>
        <field name="code">model._cron_pull()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="priority">9</field>
        <field name="active" eval="True" />
    </record>
</odoo>
