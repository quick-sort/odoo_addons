<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_task_dependency_graph" model="ir.actions.client">
        <field name="name">Task Dependencies</field>
        <field name="tag">task_dependency_graph</field>
    </record>

    <record id="view_project_form_dependency_button" model="ir.ui.view">
        <field name="name">project.project.form.dependency.button</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_open_task_dependency_graph"
                        icon="fa-sitemap"
                        string="Dependencies"/>
            </xpath>
        </field>
    </record>
</odoo>
