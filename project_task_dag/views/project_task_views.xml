<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_dag" model="ir.ui.view">
        <field name="name">project.task.dag</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <dag string="Task Dependencies"/>
        </field>
    </record>

    <record id="project_task_dag_action_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="50"/>
        <field name="view_mode">dag</field>
        <field name="view_id" ref="view_project_task_dag"/>
        <field name="act_window_id" ref="project.act_project_project_2_project_task_all"/>
    </record>

    <record id="project_task_dag_all_tasks_action_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="50"/>
        <field name="view_mode">dag</field>
        <field name="view_id" ref="view_project_task_dag"/>
        <field name="act_window_id" ref="project.action_view_all_task"/>
    </record>
</odoo>
