<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_cloud_firewall_sync" model="ir.cron">
            <field name="name">云防火墙白名单定时同步</field>
            <field ref="cloud_firewall.model_cloud_firewall_target" name="model_id"/>
            <field eval="True" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="state">code</field>
            <field name="code">model.cron_sync_all()</field>
        </record>

        <record id="default_sync_config" model="cloud.firewall.sync.config">
            <field name="ip_service_url">http://ipaddress.ai/json</field>
        </record>
    </data>
</odoo>
