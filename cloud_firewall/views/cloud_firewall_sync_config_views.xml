<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cloud_firewall_sync_config_form" model="ir.ui.view">
        <field name="name">cloud.firewall.sync.config.form</field>
        <field name="model">cloud.firewall.sync.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_fetch_current_ip" type="object" string="获取当前 IP"
                            class="btn-primary" icon="fa-globe"
                            groups="cloud.group_cloud_manager"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2>同步配置</h2>
                    </div>
                    <group>
                        <group>
                            <field name="ip_service_url"/>
                            <field name="current_ip"/>
                            <field name="last_sync"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cloud_firewall_sync_config_open" model="ir.actions.server">
        <field name="name">同步配置</field>
        <field name="model_id" ref="model_cloud_firewall_sync_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_config()</field>
    </record>
</odoo>
