<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_category_tree" model="ir.ui.view">
        <field name="name">web_tree_list_demo.category.tree</field>
        <field name="model">web_tree_list_demo.category</field>
        <field name="arch" type="xml">
            <list js_class="tree_list" default_group_by="parent_id" default_order="sequence, name">
                <field name="name"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_category_form" model="ir.ui.view">
        <field name="name">web_tree_list_demo.category.form</field>
        <field name="model">web_tree_list_demo.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="sequence"/>
                    </group>
                    <group string="Children">
                        <field name="child_ids">
                            <tree>
                                <field name="name"/>
                                <field name="sequence"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_category_tree" model="ir.actions.act_window">
        <field name="name">Tree List Demo</field>
        <field name="res_model">web_tree_list_demo.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_tree_list_demo_root" name="Tree List Demo" sequence="90"/>
    <menuitem id="menu_category_tree"
              parent="menu_tree_list_demo_root"
              action="action_category_tree"
              sequence="10"/>

</odoo>
