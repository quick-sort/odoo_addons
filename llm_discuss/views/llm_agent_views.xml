<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_llm_agent_form_inherit_discuss" model="ir.ui.view">
        <field name="name">llm.agent.form.inherit.discuss</field>
        <field name="model">llm.agent</field>
        <field name="inherit_id" ref="llm.view_llm_agent_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Discuss / Live Chat" name="discuss">
                    <group>
                        <group name="discuss_config" string="Dedicated Bot User">
                            <field name="discuss_enabled" />
                            <field
                                name="discuss_trigger_mode"
                                invisible="not discuss_enabled"
                            />
                            <field name="discuss_user_id" readonly="1" />
                            <button
                                name="action_create_discuss_user"
                                type="object"
                                string="Create Bot User"
                                class="btn-secondary"
                                invisible="discuss_user_id"
                            />
                        </group>
                        <group name="odoobot_config" string="OdooBot Private Chat">
                            <field name="odoobot_enabled" />
                        </group>
                    </group>
                    <div class="alert alert-info mt-2" role="alert">
                        <p>
                            <strong>Dedicated bot:</strong> create an internal technical
                            user and add it to Discuss chats/channels. Install
                            <code>llm_discuss_livechat</code> to assign that user as a
                            Live Chat operator.
                        </p>
                        <p class="mb-0">
                            <strong>OdooBot private chat:</strong> only one agent can
                            be selected. Native onboarding and <code>/help</code> remain
                            unchanged; after onboarding, this agent answers in the
                            same chat with the OdooBot name and avatar. OdooBot is only
                            the visible reply identity—record reads, hidden threads, and
                            tools always use the sender's permissions.
                        </p>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
