<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="llm_discuss.AssistantLauncher">
        <Dropdown t-if="llmDiscuss.assistants.length" position="'bottom-end'">
            <button
                type="button"
                class="dropdown-toggle o-dropdown--narrow"
                title="AI Assistant"
                aria-label="AI Assistant"
            >
                <i class="fa fa-magic fa-lg px-1" />
            </button>
            <t t-set-slot="content">
                <t
                    t-foreach="llmDiscuss.assistants"
                    t-as="assistant"
                    t-key="assistant.id"
                >
                    <DropdownItem onSelected="() => this.openAssistant(assistant)">
                        <i class="fa fa-comments-o me-2" />
                        <span t-esc="assistant.name" />
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>
</templates>
