<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_knowledge_chunkset_tree" model="ir.ui.view">
        <field name="name">knowledge.chunkset.tree</field>
        <field name="model">knowledge.chunkset</field>
        <field name="arch" type="xml">
            <list string="Chunking Configurations">
                <field name="kb_id"/>
                <field name="name"/>
                <field name="splitter_id"/>
                <field name="chunk_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_knowledge_chunkset_form" model="ir.ui.view">
        <field name="name">knowledge.chunkset.form</field>
        <field name="model">knowledge.chunkset</field>
        <field name="arch" type="xml">
            <form string="Chunking Configuration">
                <header>
                    <button
                        name="action_chunk"
                        type="object"
                        string="Chunk Now"
                        class="btn-primary"
                        invisible="state == 'chunking'"
                    />
                    <button
                        name="action_rechunk"
                        type="object"
                        string="Rechunk"
                        invisible="state != 'chunked'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,chunked"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="kb_id"/>
                            <field name="name"/>
                            <field name="splitter_id"/>
                        </group>
                        <group>
                            <field name="chunk_count"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vector Stores">
                            <field
                                name="vector_ids"
                                context="{'default_chunkset_id': id}"
                            >
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="model_id"/>
                                    <field name="vector_store_id"/>
                                    <field name="vector_size"/>
                                    <field name="chunk_count"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Chunks">
                            <field name="chunk_ids">
                                <list>
                                    <field name="source_id"/>
                                    <field name="sequence"/>
                                    <field name="path"/>
                                    <field name="file_size"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_knowledge_chunkset" model="ir.actions.act_window">
        <field name="name">Chunking Configurations</field>
        <field name="res_model">knowledge.chunkset</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
