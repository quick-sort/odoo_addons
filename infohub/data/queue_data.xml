<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Channel capacity is configured in odoo.conf, not in the database:

             [queue_job]
             channels = root:4,root.infohub:2

         A missing entry silently falls back to the default capacity, which
         would quietly disable any rate limiting that depends on it.
    -->
    <record id="channel_infohub" model="queue.job.channel">
        <field name="name">infohub</field>
        <field name="parent_id" ref="queue_job.channel_root" />
    </record>
</odoo>
