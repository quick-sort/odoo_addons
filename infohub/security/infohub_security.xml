<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_groups_privilege_infohub" model="res.groups.privilege">
        <field name="name">InfoHub</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_administration" />
    </record>

    <record id="group_infohub_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Can read aggregated news items.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_infohub" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_infohub_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Can manage channels and sources.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_infohub" />
        <field name="implied_ids" eval="[(4, ref('infohub.group_infohub_user'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]" />
    </record>
</odoo>
