<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_infohub_item_list" model="ir.ui.view">
        <field name="name">infohub.item.list</field>
        <field name="model">infohub.item</field>
        <field name="arch" type="xml">
            <list
                string="条目"
                decoration-muted="state in ('rejected', 'blocked')"
                decoration-bf="state == 'fetched'"
            >
                <field name="published_at" />
                <field name="title" />
                <field name="source_id" />
                <field name="medium" optional="show" />
                <field name="author_name" optional="hide" />
                <field name="url_host" optional="hide" />
                <field name="lang" optional="hide" />
                <field name="topic_ids" widget="many2many_tags" optional="show" />
                <field name="tag_ids" widget="many2many_tags" optional="hide" />
                <field name="score" optional="hide" />
                <field name="state" widget="badge" />
                <button
                    name="action_block"
                    type="object"
                    string="标黑"
                    icon="fa-ban"
                    groups="infohub.group_moderator"
                    invisible="state == 'blocked'"
                />
            </list>
        </field>
    </record>

    <record id="view_infohub_item_form" model="ir.ui.view">
        <field name="name">infohub.item.form</field>
        <field name="model">infohub.item</field>
        <field name="arch" type="xml">
            <form string="条目">
                <header>
                    <button
                        name="action_publish"
                        type="object"
                        string="发布"
                        class="btn-primary"
                        groups="infohub.group_moderator"
                        invisible="state == 'published'"
                    />
                    <button
                        name="action_block"
                        type="object"
                        string="标黑"
                        groups="infohub.group_moderator"
                        invisible="state == 'blocked'"
                    />
                    <button
                        name="action_unblock"
                        type="object"
                        string="撤销标黑"
                        groups="infohub.group_moderator"
                        invisible="state != 'blocked'"
                    />
                    <button
                        name="action_reject"
                        type="object"
                        string="拒绝"
                        groups="infohub.group_moderator"
                        invisible="state in ('rejected', 'blocked')"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="fetched,published"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title" readonly="1" /></h1>
                    </div>
                    <group>
                        <group name="meta">
                            <field name="source_id" readonly="1" />
                            <field name="medium" readonly="1" />
                            <field name="author_name" readonly="1" />
                            <field name="published_at" readonly="1" />
                            <field name="lang" readonly="1" />
                        </group>
                        <group name="links">
                            <field name="url" widget="url" readonly="1" />
                            <field name="url_host" readonly="1" />
                            <field name="external_id" readonly="1" />
                            <field name="identity_key" readonly="1" />
                            <field name="fetched_at" readonly="1" />
                        </group>
                    </group>
                    <group string="分类">
                        <field name="primary_topic_id" />
                        <field name="topic_ids" widget="many2many_tags" />
                        <field name="tag_ids" widget="many2many_tags" />
                        <field name="score" />
                    </group>
                    <notebook>
                        <page string="摘要" name="summary">
                            <field name="summary" readonly="1" />
                        </page>
                        <page string="正文" name="content">
                            <field name="content" readonly="1" />
                        </page>
                        <page
                            string="审核"
                            name="moderation"
                            groups="infohub.group_moderator"
                        >
                            <field name="moderation_note" readonly="1" />
                        </page>
                        <page
                            string="原始数据"
                            name="raw"
                            groups="infohub.group_manager"
                        >
                            <p class="text-muted">
                                来源方的原始报文。解析规则变更后可据此重跑归一化，
                                不必重新联网。
                            </p>
                            <field name="raw_data" widget="json" readonly="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_infohub_item_search" model="ir.ui.view">
        <field name="name">infohub.item.search</field>
        <field name="model">infohub.item</field>
        <field name="arch" type="xml">
            <search string="条目">
                <field name="title" />
                <field
                    name="content_text"
                    string="正文"
                    filter_domain="[('content_text', 'ilike', self)]"
                />
                <field name="source_id" />
                <field name="author_name" />
                <field name="topic_ids" />
                <field name="tag_ids" />
                <filter
                    name="filter_published"
                    string="已发布"
                    domain="[('state', '=', 'published')]"
                />
                <filter
                    name="filter_pending"
                    string="待审核"
                    domain="[('state', '=', 'fetched')]"
                />
                <filter
                    name="filter_blocked"
                    string="已标黑"
                    domain="[('state', '=', 'blocked')]"
                />
                <separator />
                <filter
                    name="filter_today"
                    string="今天"
                    domain="[('published_at', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0)))]"
                />
                <filter
                    name="filter_week"
                    string="近 7 天"
                    domain="[('published_at', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"
                />
                <group name="group_by">
                    <filter
                        name="group_by_source"
                        string="来源"
                        context="{'group_by': 'source_id'}"
                    />
                    <filter name="group_by_medium" string="介质" context="{'group_by': 'medium'}" />
                    <filter name="group_by_state" string="状态" context="{'group_by': 'state'}" />
                    <filter
                        name="group_by_topic"
                        string="主学科"
                        context="{'group_by': 'primary_topic_id'}"
                    />
                    <filter
                        name="group_by_date"
                        string="发布月份"
                        context="{'group_by': 'published_at:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_infohub_item" model="ir.actions.act_window">
        <field name="name">条目</field>
        <field name="res_model">infohub.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_infohub_item_pending" model="ir.actions.act_window">
        <field name="name">待审核条目</field>
        <field name="res_model">infohub.item</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'fetched')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">没有待审核的条目</p>
            <p>
                默认策略是自动发布（ADR-009）。条目停留在「已抓取」通常意味着
                安装了 infohub_filter 且有规则把它挂起。
            </p>
        </field>
    </record>

</odoo>
