<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <menuitem
        id="menu_infohub_root"
        name="InfoHub"
        web_icon="infohub,static/description/icon.png"
        sequence="85"
        groups="group_infohub_user"
    />
    <menuitem
        id="menu_infohub_item"
        name="Info"
        parent="menu_infohub_root"
        action="action_infohub_item"
        sequence="10"
    />
    <menuitem
        id="menu_infohub_settings"
        name="Settings"
        parent="menu_infohub_root"
        groups="group_infohub_manager"
        sequence="90"
    />
    <menuitem
        id="menu_infohub_channel"
        name="Channels"
        parent="menu_infohub_settings"
        sequence="10"
    />
    <menuitem
        id="menu_infohub_channel_list"
        name="Channels"
        parent="menu_infohub_channel"
        action="action_infohub_channel"
        sequence="10"
    />
    <!-- <menuitem> alone leaves a previously-set action in place on upgrade,
         so clear it explicitly now that it moved to the child menu. -->
    <record id="menu_infohub_channel" model="ir.ui.menu">
        <field name="action" eval="False" />
    </record>
    <menuitem
        id="menu_infohub_source"
        name="Sources"
        parent="menu_infohub_settings"
        action="action_infohub_source"
        sequence="20"
    />
</odoo>
