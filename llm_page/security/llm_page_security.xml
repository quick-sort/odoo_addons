<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="privilege_llm_page">
        <field name="name">LLM Page</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>

    <record id="group_viewer" model="res.groups">
        <field name="name">LLM Page Viewer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="llm_page.privilege_llm_page"/>
    </record>

    <record id="group_reviewer" model="res.groups">
        <field name="name">LLM Page Reviewer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="llm_page.privilege_llm_page"/>
        <field name="implied_ids" eval="[(4, ref('llm_page.group_viewer'))]"/>
    </record>
</odoo>
