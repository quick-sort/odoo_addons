<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_knowledge_extractor_tree" model="ir.ui.view">
        <field name="name">knowledge.extractor.tree</field>
        <field name="model">knowledge.extractor</field>
        <field name="arch" type="xml">
            <list string="Extractors">
                <field name="name"/>
                <field name="extractor_type"/>
                <field name="api_url"/>
            </list>
        </field>
    </record>

    <record id="view_knowledge_extractor_form" model="ir.ui.view">
        <field name="name">knowledge.extractor.form</field>
        <field name="model">knowledge.extractor</field>
        <field name="arch" type="xml">
            <form string="Extractor">
                <header>
                    <button
                        name="action_test_config"
                        type="object"
                        string="Test Connection"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="extractor_type"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="api_url"/>
                            <field name="api_key" password="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_knowledge_extractor" model="ir.actions.act_window">
        <field name="name">Extractors</field>
        <field name="res_model">knowledge.extractor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
