<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_agent_agent" model="ir.actions.act_window">
        <field name="name">Agents</field>
        <field name="res_model">agent.agent</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_agent_agent_tree" model="ir.ui.view">
        <field name="name">agent.agent.tree</field>
        <field name="model">agent.agent</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="provider_id"/>
                <field name="model_id"/>
                <field name="runner"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_agent_agent_form" model="ir.ui.view">
        <field name="name">agent.agent.form</field>
        <field name="model">agent.agent</field>
        <field name="arch" type="xml">
            <form string="Agent">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_test" string="Test" type="object" class="oe_stat_button" icon="fa-play"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="provider_id"/>
                            <field name="model_id"/>
                            <field name="runner"/>
                        </group>
                    </group>
                    <group string="System Prompt">
                        <field name="system_prompt" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Tools">
                        <field name="tool_ids" widget="many2many_tags"/>
                        <field name="tool_calls_max"/>
                    </group>
                    <group string="Advanced">
                        <field name="context_limit"/>
                        <field name="temperature"/>
                        <field name="max_tokens"/>
                        <field name="use_streaming"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
