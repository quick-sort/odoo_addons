<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_wechat.WechatHtmlPreviewField">
        <div class="o_wechat_html_preview w-100">
            <div t-if="!value" class="text-muted fst-italic">（无正文内容）</div>
            <iframe t-else="" t-ref="iframe"
                    class="o_wechat_html_preview_frame w-100 border rounded bg-white"
                    t-att-style="`height: ${props.height}px;`"
                    sandbox="allow-same-origin"/>
        </div>
    </t>

</templates>
