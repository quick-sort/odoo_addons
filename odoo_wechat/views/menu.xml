<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- 应用主菜单，整个企业微信集成作为独立App，仅系统管理员可见/操作 -->
    <menuitem name="企业微信" id="wechat_root_menu" sequence="120" groups="base.group_system"
              web_icon="odoo_wechat,static/description/icon.png"/>

    <menuitem id="wechat_app_menu" name="企微应用" parent="wechat_root_menu" sequence="10"
              action="wechat_app_action"/>

    <menuitem id="wechat_app_message_menu" name="发布历史" parent="wechat_root_menu" sequence="20"
              action="wechat_app_message_action"/>

    <menuitem id="wechat_contacts_menu" name="通讯录" parent="wechat_root_menu" sequence="30"/>

    <menuitem id="wechat_department_menu" name="企微部门" parent="wechat_contacts_menu" sequence="10"
              action="wechat_department_action"/>

    <menuitem id="wechat_user_menu" name="企微成员" parent="wechat_contacts_menu" sequence="20"
              action="wechat_user_action"/>

</odoo>
