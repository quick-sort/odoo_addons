<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_gantt" model="ir.ui.view">
        <field name="name">project.task.gantt</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <gantt string="Tasks Gantt Chart" date_start="task_start_date" date_stop="task_end_date"/>
        </field>
    </record>

    <record id="project_task_gantt_action_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="50"/>
        <field name="view_mode">gantt</field>
        <field name="view_id" ref="view_project_task_gantt"/>
        <field name="act_window_id" ref="project.act_project_project_2_project_task_all"/>
    </record>

    <record id="project_task_gantt_all_tasks_action_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="50"/>
        <field name="view_mode">gantt</field>
        <field name="view_id" ref="view_project_task_gantt"/>
        <field name="act_window_id" ref="project.action_view_all_task"/>
    </record>
</odoo>
