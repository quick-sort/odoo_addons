<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wecom_app_message_tree" model="ir.ui.view">
        <field name="name">wecom.app.message.tree</field>
        <field name="model">wecom.app.message</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="创建时间"/>
                <field name="app_id"/>
                <field name="name"/>
                <field name="msg_type"/>
                <field name="source" optional="show"/>
                <field name="send_date"/>
                <field name="state" widget="badge" decoration-success="state == 'sent'" decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_wecom_app_message_form" model="ir.ui.view">
        <field name="name">wecom.app.message.form</field>
        <field name="model">wecom.app.message</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="发布" name="action_publish" type="object" class="oe_highlight" invisible="state == 'sent'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <group col="2">
                        <group>
                            <field name="app_id"/>
                            <field name="name"/>
                            <field name="msg_type"/>
                            <field name="url" invisible="msg_type != 'textcard'" required="msg_type == 'textcard'"/>
                            <field name="btn_text" invisible="msg_type != 'textcard'"/>
                            <field name="source" invisible="source == 'manual'"/>
                            <field name="source_ref" invisible="not source_ref"/>
                        </group>
                        <group string="接收范围">
                            <field name="send_to_all"/>
                            <field name="user_ids" widget="many2many_tags"
                                   domain="[('company_id', '=', company_id)]"
                                   invisible="send_to_all == True"/>
                            <field name="department_ids" widget="many2many_tags"
                                   domain="[('company_id', '=', company_id)]"
                                   invisible="send_to_all == True"/>
                            <field name="touser" invisible="send_to_all == True" placeholder="user1|user2"/>
                            <field name="toparty" invisible="send_to_all == True" placeholder="1|2"/>
                            <field name="totag" invisible="send_to_all == True"/>
                        </group>
                    </group>
                    <group string="描述" invisible="msg_type != 'textcard'">
                        <field name="description" nolabel="1" placeholder="消息描述内容..."/>
                    </group>
                    <group string="文章" invisible="msg_type == 'textcard'">
                        <div class="alert alert-info mb-2" role="alert" invisible="state == 'sent'">
                            图文消息(news)每篇需填标题/链接/缩略图；图文素材消息(mpnews)每篇需填标题、
                            HTML正文与封面图。企业微信一次最多发 8 篇，超过会自动分多条发送。
                        </div>
                        <field name="article_ids" readonly="state == 'sent'">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="title"/>
                                <field name="url" invisible="parent.msg_type != 'news'"/>
                                <field name="image_url" invisible="parent.msg_type != 'news'"/>
                                <field name="author" invisible="parent.msg_type != 'mpnews'"/>
                            </list>
                        </field>
                    </group>
                    <group string="发送结果" invisible="state == 'draft'">
                        <field name="send_date"/>
                        <field name="invalid_user"/>
                        <field name="invalid_party"/>
                        <field name="invalid_tag"/>
                        <field name="result"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wecom_app_message_article_form" model="ir.ui.view">
        <field name="name">wecom.app.message.article.form</field>
        <field name="model">wecom.app.message.article</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="title"/>
                    <field name="url" invisible="parent.msg_type != 'news'" required="parent.msg_type == 'news'"/>
                    <field name="image_url" invisible="parent.msg_type != 'news'" required="parent.msg_type == 'news'"/>
                    <field name="description" invisible="parent.msg_type != 'news'"/>
                </group>
                <group invisible="parent.msg_type != 'mpnews'">
                    <field name="thumb_image" widget="image" options="{'size': [0, 200], 'zoom': true}"
                           filename="thumb_image_filename" required="parent.msg_type == 'mpnews'"/>
                    <field name="thumb_image_filename" invisible="1"/>
                    <field name="author"/>
                    <field name="show_cover_pic"/>
                    <field name="content_source_url"/>
                    <field name="digest"/>
                    <field name="content_image" widget="image" options="{'size': [0, 200], 'zoom': true}"
                           filename="content_image_filename" invisible="not content_image"/>
                    <field name="content_image_filename" invisible="1"/>
                </group>
                <group invisible="parent.msg_type != 'mpnews'">
                    <field name="content" widget="ace" options="{'mode': 'xml'}"
                           required="parent.msg_type == 'mpnews' and not content_image"/>
                </group>
                <div class="mb-2" invisible="parent.msg_type != 'mpnews'">
                    <button string="预览正文" name="action_preview_content" type="object"
                            class="btn btn-secondary" icon="fa-eye"/>
                </div>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="wecom_app_message_action">
        <field name="name">发布历史</field>
        <field name="res_model">wecom.app.message</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
