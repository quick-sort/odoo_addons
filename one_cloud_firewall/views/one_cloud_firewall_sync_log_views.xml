<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cloud_firewall_sync_log_list" model="ir.ui.view">
        <field name="name">one.cloud.firewall.sync.log.list</field>
        <field name="model">one.cloud.firewall.sync.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date" string="时间"/>
                <field name="target_id"/>
                <field name="provider" optional="hide"/>
                <field name="ip_from"/>
                <field name="ip_to"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('success', 'unchanged')"
                       decoration-danger="state == 'failed'"/>
                <field name="message" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_cloud_firewall_sync_log_form" model="ir.ui.view">
        <field name="name">one.cloud.firewall.sync.log.form</field>
        <field name="model">one.cloud.firewall.sync.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="target_id"/>
                            <field name="create_date" string="时间"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="ip_from"/>
                            <field name="ip_to"/>
                        </group>
                    </group>
                    <field name="message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cloud_firewall_sync_log" model="ir.actions.act_window">
        <field name="name">同步日志</field>
        <field name="res_model">one.cloud.firewall.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
