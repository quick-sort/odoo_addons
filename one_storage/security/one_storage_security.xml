<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_one_storage" model="ir.module.category">
        <field name="name">One Storage</field>
        <field name="sequence">20</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_one_storage">
        <field name="name">One Storage</field>
        <field name="category_id" ref="module_category_one_storage"/>
    </record>

    <record id="group_one_storage_user" model="res.groups">
        <field name="name">User: own documents only</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_one_storage"/>
    </record>

    <record id="group_one_storage_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_one_storage_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_one_storage"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
