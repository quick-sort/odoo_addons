<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_one_storage_entry_upload_wizard_form" model="ir.ui.view">
        <field name="name">one.storage.entry.upload.wizard.form</field>
        <field name="model">one.storage.entry.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload File">
                <group>
                    <group>
                        <field name="entry_id" readonly="1"/>
                        <field name="entry_name" invisible="1"/>
                        <field name="datas" filename="filename"
                               file="true" string="File"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <div class="text-muted">
                        The selected file replaces the current content of this entry.
                    </div>
                </group>
                <footer>
                    <button name="action_apply" type="object"
                            string="Upload" class="btn-primary"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
