<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_one_storage_entry_create_wizard_form" model="ir.ui.view">
        <field name="name">one.storage.entry.create.wizard.form</field>
        <field name="model">one.storage.entry.create.wizard</field>
        <field name="arch" type="xml">
            <form string="New">
                <group>
                    <group>
                        <field name="parent_id" invisible="1"/>
                        <field name="parent_name" invisible="1"/>
                        <field name="folder_name" string="New Folder Name"
                               placeholder="e.g. Projects"/>
                        <field name="datas" filename="filename" file="true"
                               string="Upload File"/>
                        <field name="filename" invisible="1"/>
                    </group>
                </group>
                <div class="text-muted">
                    Create a folder, upload a file into this folder, or both
                    (the file then goes into the new folder).
                </div>
                <footer>
                    <button name="action_apply" type="object"
                            string="Create" class="btn-primary"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_one_storage_entry_create" model="ir.actions.act_window">
        <field name="name">New</field>
        <field name="res_model">one.storage.entry.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
