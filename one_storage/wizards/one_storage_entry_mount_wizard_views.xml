<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_one_storage_entry_mount_wizard_form" model="ir.ui.view">
        <field name="name">one.storage.entry.mount.wizard.form</field>
        <field name="model">one.storage.entry.mount.wizard</field>
        <field name="arch" type="xml">
            <form string="Mount Backend">
                <group>
                    <group>
                        <field name="entry_id" readonly="1"/>
                        <field name="entry_name" invisible="1"/>
                        <field name="backend_id"
                               options="{'no_create': True}"/>
                        <field name="backend_path"/>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" type="object"
                            string="Mount" class="btn-primary"/>
                    <button string="Discard" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
