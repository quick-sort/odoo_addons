<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_one_storage_entry_delete_wizard_form" model="ir.ui.view">
        <field name="name">one.storage.entry.delete.wizard.form</field>
        <field name="model">one.storage.entry.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Delete Entry">
                <field name="is_dir" invisible="1"/>
                <group>
                    <div class="alert alert-danger" role="alert">
                        Are you sure you want to delete
                        <field name="entry_name" readonly="1" class="oe_inline fw-bold"/>?
                        <span invisible="is_dir == False">
                            The file will also be removed from the storage backend.
                        </span>
                    </div>
                </group>
                <field name="entry_id" invisible="1"/>
                <footer>
                    <button name="action_apply" type="object"
                            string="Delete" class="btn-danger"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
