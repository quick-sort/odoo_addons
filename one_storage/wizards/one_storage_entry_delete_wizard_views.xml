<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_one_storage_entry_delete_wizard_form" model="ir.ui.view">
        <field name="name">one.storage.entry.delete.wizard.form</field>
        <field name="model">one.storage.entry.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Delete Entry">
                <field name="has_dir" invisible="1"/>
                <group>
                    <div class="alert alert-danger" role="alert">
                        <p>Are you sure you want to delete:</p>
                        <field name="entry_names" readonly="1" class="oe_inline fw-bold"/>
                        <p>
                            Files will also be removed from the storage backend.
                        </p>
                    </div>
                    <field name="recursive" invisible="has_dir == False"/>
                </group>
                <footer>
                    <button name="action_apply" type="object"
                            string="Delete" class="btn-danger"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
