<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="storage_backend_view_form_one_storage" model="ir.ui.view">
        <field name="name">storage.backend.form.one.storage</field>
        <field name="model">storage.backend</field>
        <field name="inherit_id" ref="storage_backend.storage_backend_view_form"/>
        <field name="arch" type="xml">
            <button name="%(storage_backend.action_storage_backend_file_list_wizard)d"
                    position="replace">
                <button type="object" name="action_open_files"
                        string="Manage Files" icon="fa-folder-open"/>
                <button type="object" name="action_sync_file_tree"
                        string="Sync File Tree" icon="fa-refresh"
                        confirm="Refresh the whole file tree from the backend in the background?"/>
            </button>
            <group name="config" position="inside">
                <field name="entry_id" options="{'no_create': True}"/>
            </group>
        </field>
    </record>
</odoo>
