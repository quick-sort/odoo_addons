<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- File browser: kanban mixes directories and files; clicking a
         directory descends into it (action_open_children). -->
    <record id="view_one_storage_entry_kanban" model="ir.ui.view">
        <field name="name">one.storage.entry.kanban</field>
        <field name="model">one.storage.entry</field>
        <field name="arch" type="xml">
            <kanban create="true" sample="1" js_class="one_storage_entry_kanban"
                    action="action_open_children" type="object"
                    on_create="one_storage.action_one_storage_entry_create">
                <field name="name"/>
                <field name="entry_type"/>
                <field name="is_dir"/>
                <field name="mimetype"/>
                <field name="backend_id"/>
                <field name="binding_id"/>
                <field name="child_count"/>
                <field name="file_size"/>
                <field name="display_size"/>
                <field name="last_sync"/>
                <field name="display_last_sync"/>
                <header>
                    <button name="action_move_selected" type="object"
                            string="Move" display="selection"
                            icon="fa-arrows" class="btn-secondary"/>
                    <button name="action_delete_selected" type="object"
                            string="Delete" display="selection"
                            icon="fa-trash-o" class="btn-danger"
                            confirm="Delete the selected entries?"/>
                </header>
                <templates>
                    <t t-name="menu">
                        <a name="action_edit" type="object" role="menuitem"
                           class="dropdown-item">Edit</a>
                        <a name="action_rename" type="object" role="menuitem"
                           class="dropdown-item">Rename</a>
                        <a name="action_move" type="object" role="menuitem"
                           class="dropdown-item">Move</a>
                        <a t-if="record.is_dir.raw_value"
                           name="action_refresh" type="object" role="menuitem"
                           class="dropdown-item">Refresh</a>
                        <a t-if="record.is_dir.raw_value and !record.backend_id.raw_value and !record.binding_id.raw_value"
                           name="action_mount_wizard" type="object" role="menuitem"
                           class="dropdown-item">Mount Backend</a>
                        <a t-if="record.is_dir.raw_value and (record.backend_id.raw_value or record.binding_id.raw_value)"
                           name="action_mount_wizard" type="object" role="menuitem"
                           class="dropdown-item">Unmount Backend</a>
                        <a t-if="!record.is_dir.raw_value"
                           name="action_upload" type="object" role="menuitem"
                           class="dropdown-item">Upload</a>
                        <a t-if="!record.is_dir.raw_value"
                           t-attf-href="/one_storage/entry/#{record.id.raw_value}/download"
                           download="" class="dropdown-item">Download</a>
                        <a name="action_delete" type="object" role="menuitem"
                           class="dropdown-item text-danger">Delete</a>
                    </t>
                    <t t-name="card" class="o_kanban_attachment flex-row">
                        <aside class="o_kanban_image m-1">
                            <div class="o_kanban_image_wrapper d-flex align-items-center justify-content-center">
                                <i t-if="record.is_dir.raw_value"
                                   class="fa fa-folder fa-3x text-warning"
                                   title="Directory" role="img"/>
                                <div t-else=""
                                     class="o_image o_image_thumbnail"
                                     t-att-data-mimetype="record.mimetype.value"/>
                            </div>
                        </aside>
                        <main class="ms-1">
                            <div class="d-flex flex-column justify-content-between flex-grow-1">
                                <field name="name" class="text-truncate fw-bold fs-5 mt-3"/>
                                <footer class="d-flex align-items-center pb-1 pe-1">
                                    <small t-if="record.is_dir.raw_value" class="text-muted me-3">
                                        <i class="fa fa-folder-o me-1" title="Sub-entries" role="img"/>
                                        <span t-if="record.child_count.raw_value">
                                            <t t-esc="record.child_count.raw_value"/>
                                        </span>
                                    </small>
                                    <small class="text-muted me-3">
                                        <i t-if="record.is_dir.raw_value"
                                           class="fa fa-database me-1" title="Total size" role="img"/>
                                        <t t-esc="record.display_size.value"/>
                                    </small>
                                    <small t-if="record.last_sync.raw_value"
                                           class="text-muted me-3"
                                           t-att-title="record.last_sync.value">
                                        <i class="fa fa-clock-o me-1" title="Last sync" role="img"/>
                                        <t t-esc="record.display_last_sync.value"/>
                                    </small>
                                    <field name="backend_id" class="ms-auto badge text-bg-secondary"/>
                                </footer>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_one_storage_entry_list" model="ir.ui.view">
        <field name="name">one.storage.entry.list</field>
        <field name="model">one.storage.entry</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_move_selected" type="object"
                            string="Move" display="selection"
                            icon="fa-arrows" class="btn-secondary"/>
                    <button name="action_delete_selected" type="object"
                            string="Delete" display="selection"
                            icon="fa-trash-o" class="btn-danger"
                            confirm="Delete the selected entries?"/>
                </header>
                <field name="name"/>
                <field name="entry_type"/>
                <field name="mimetype"/>
                <field name="file_size"/>
                <field name="backend_id"/>
                <field name="state"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>

    <record id="view_one_storage_entry_form" model="ir.ui.view">
        <field name="name">one.storage.entry.form</field>
        <field name="model">one.storage.entry</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_download" type="object"
                            string="Download" class="oe_highlight"
                            invisible="entry_type == 'directory'"/>
                    <button name="action_resync" type="object" string="Resync"
                            invisible="entry_type == 'directory'"/>
                    <button name="action_rename" type="object" string="Rename"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="entry name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="entry_type"/>
                            <field name="parent_id" options="{'no_create': True}"
                                   invisible="id == False"/>
                            <field name="backend_id"
                                   invisible="entry_type != 'directory'"/>
                            <field name="read_only"
                                   invisible="entry_type != 'directory'"/>
                            <field name="binding_id" options="{'no_create': True}"
                                   invisible="entry_type != 'directory'"/>
                        </group>
                        <group invisible="entry_type == 'directory'">
                            <field name="mimetype" readonly="id == False"/>
                            <field name="file_size" readonly="id == False"/>
                            <field name="checksum" readonly="id == False"
                                   invisible="id == False"/>
                            <field name="state" readonly="id == False"/>
                            <field name="last_sync" readonly="id == False"
                                   invisible="id == False"/>
                        </group>
                    </group>
                    <notebook invisible="entry_type != 'directory'">
                        <page string="Content">
                            <field name="child_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="entry_type"/>
                                    <field name="mimetype"/>
                                    <field name="file_size"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_one_storage_entry_search" model="ir.ui.view">
        <field name="name">one.storage.entry.search</field>
        <field name="model">one.storage.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="backend_id"/>
                <filter name="filter_directories" string="Directories"
                        domain="[('entry_type', '=', 'directory')]"/>
                <filter name="filter_files" string="Files"
                        domain="[('entry_type', '=', 'file')]"/>
                <separator/>
                <filter name="group_backend" string="Backend"
                        context="{'group_by': 'backend_id'}"/>
            </search>
        </field>
    </record>

    <!-- Files opens straight into the global root's contents: the root
         itself is an implementation detail and never shows as a card. -->
    <record id="action_one_storage_entry_browser" model="ir.actions.server">
        <field name="name">Files</field>
        <field name="model_id" ref="one_storage.model_one_storage_entry"/>
        <field name="state">code</field>
        <field name="code">root = env["one.storage.entry"]._get_or_create_root()
action = root.action_open_children()</field>
    </record>

</odoo>
