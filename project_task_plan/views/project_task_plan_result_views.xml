<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_plan_result_form" model="ir.ui.view">
        <field name="name">project.task.plan.result.form</field>
        <field name="model">project.task.plan.result</field>
        <field name="arch" type="xml">
            <form string="Auto Align Result">
                <sheet>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="moved_count"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="task_id"/>
                            <field name="old_start_date"/>
                            <field name="old_end_date"/>
                            <field name="new_start_date"/>
                            <field name="new_end_date"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
