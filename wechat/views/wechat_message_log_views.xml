<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wechat_message_log_list" model="ir.ui.view">
        <field name="name">wechat.message.log.list</field>
        <field name="model">wechat.message.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="时间"/>
                <field name="from_user"/>
                <field name="msg_type"/>
                <field name="event_type" optional="hide"/>
                <field name="content" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="direction"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_wechat_message_log_form" model="ir.ui.view">
        <field name="name">wechat.message.log.form</field>
        <field name="model">wechat.message.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="基本信息">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="msgid"/>
                            <field name="direction"/>
                            <field name="state"/>
                        </group>
                        <group string="消息内容">
                            <field name="msg_type"/>
                            <field name="event_type"/>
                            <field name="content"/>
                        </group>
                    </group>
                    <group string="用户信息">
                        <group>
                            <field name="from_user"/>
                            <field name="to_user"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="location_x"/>
                            <field name="location_y"/>
                            <field name="label"/>
                        </group>
                    </group>
                    <group string="媒体信息">
                        <group>
                            <field name="media_id"/>
                            <field name="thumb_media_id" optional="hide"/>
                            <field name="pic_url"/>
                        </group>
                        <group string="回复跟踪">
                            <field name="reply_type"/>
                            <field name="reply_content"/>
                        </group>
                    </group>
                    <group string="图文信息" invisible="msg_type != 'link'">
                        <group>
                            <field name="title"/>
                            <field name="description"/>
                            <field name="url"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wechat_message_log_search" model="ir.ui.view">
        <field name="name">wechat.message.log.search</field>
        <field name="model">wechat.message.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="msgid"/>
                <field name="from_user"/>
                <field name="content"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="接收" name="inbound"
                        domain="[('direction', '=', 'inbound')]"/>
                <filter string="发送" name="outbound"
                        domain="[('direction', '=', 'outbound')]"/>
                <filter string="公司" name="group_company"
                            context="{'group_by': 'company_id'}"/>
                    <filter string="消息类型" name="group_msg_type"
                            context="{'group_by': 'msg_type'}"/>
                    <filter string="时间" name="group_date"
                            context="{'group_by': 'create_date:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_wechat_message_log" model="ir.actions.act_window">
        <field name="name">消息记录</field>
        <field name="res_model">wechat.message.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_inbound': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">还没有消息记录</p>
            <p>用户发送的消息和系统回复会记录在这里。</p>
        </field>
    </record>
</odoo>
