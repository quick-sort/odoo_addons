<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wechat_mass_message_list" model="ir.ui.view">
        <field name="name">wechat.mass.message.list</field>
        <field name="model">wechat.mass.message</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="msg_type"/>
                <field name="scheduled_date" optional="hide"/>
                <field name="sent_date" optional="hide"/>
                <field name="state"/>
                <field name="msg_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wechat_mass_message_form" model="ir.ui.view">
        <field name="name">wechat.mass.message.form</field>
        <field name="model">wechat.mass.message</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" string="立即发送" type="object"
                            class="btn-primary"
                            invisible="state in ('sending', 'sent')"/>
                    <button name="action_retry" string="重试" type="object"
                            invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="消息名称"/></h1>
                    </div>
                    <group>
                        <group string="消息内容">
                            <field name="msg_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="发送设置">
                            <field name="scheduled_date"/>
                            <field name="tag_id"/>
                        </group>
                    </group>
                    <group string="内容">
                        <group invisible="msg_type != 'text'">
                            <field name="content" nolabel="1" colspan="2"/>
                        </group>
                        <group invisible="msg_type == 'text'">
                            <field name="media_id"/>
                            <field name="title" invisible="msg_type not in ('video', 'news')"/>
                            <field name="description" invisible="msg_type not in ('video', 'news')"/>
                        </group>
                    </group>
                    <group string="发送结果" invisible="state == 'draft'">
                        <group>
                            <field name="sent_date"/>
                            <field name="msg_id"/>
                        </group>
                        <group>
                            <field name="error_msg" readonly="1"
                                   invisible="state != 'failed'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wechat_mass_message_search" model="ir.ui.view">
        <field name="name">wechat.mass.message.search</field>
        <field name="model">wechat.mass.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="草稿" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="已发送" name="sent" domain="[('state', '=', 'sent')]"/>
                <filter string="发送失败" name="failed"
                        domain="[('state', '=', 'failed')]"/>
                <filter string="状态" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="消息类型" name="group_msg_type"
                            context="{'group_by': 'msg_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_wechat_mass_message" model="ir.actions.act_window">
        <field name="name">群发消息</field>
        <field name="res_model">wechat.mass.message</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">还没有群发消息</p>
            <p>创建群发消息，向关注用户发送通知。</p>
        </field>
    </record>
</odoo>
