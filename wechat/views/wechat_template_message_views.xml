<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wechat_template_message_list" model="ir.ui.view">
        <field name="name">wechat.template.message.list</field>
        <field name="model">wechat.template.message</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="template_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="send_count"/>
                <field name="last_send_time" optional="hide"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_wechat_template_message_form" model="ir.ui.view">
        <field name="name">wechat.template.message.form</field>
        <field name="model">wechat.template.message</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="归档"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="模板名称"/></h1>
                    </div>
                    <group>
                        <group string="模板配置">
                            <field name="active" invisible="1"/>
                            <field name="code"/>
                            <field name="template_id"/>
                            <field name="primary_color"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="send_count" readonly="1"/>
                            <field name="last_send_time" readonly="1"/>
                        </group>
                    </group>
                    <group string="数据格式">
                        <field name="data_schema" nolabel="1"/>
                    </group>
                    <group string="描述">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wechat_template_message_search" model="ir.ui.view">
        <field name="name">wechat.template.message.search</field>
        <field name="model">wechat.template.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="template_id"/>
                <filter string="已归档" name="inactive"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_wechat_template_message" model="ir.actions.act_window">
        <field name="name">模板消息</field>
        <field name="res_model">wechat.template.message</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">还没有模板消息</p>
            <p>添加从微信公众平台获取的模板消息配置。</p>
        </field>
    </record>
</odoo>
