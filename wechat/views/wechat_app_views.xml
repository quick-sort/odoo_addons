<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wechat_app_tree" model="ir.ui.view">
        <field name="name">wechat.app.tree</field>
        <field name="model">wechat.app</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id" optional="show"/>
                <field name="name"/>
                <field name="wechat_corp_id"/>
                <field name="wechat_agent_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_wechat_app_form" model="ir.ui.view">
        <field name="name">wechat.app.form</field>
        <field name="model">wechat.app</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="同步部门" name="action_sync_departments" type="object"/>
                    <button string="同步成员" name="action_sync_users" type="object"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="已存档" bg_color="bg-danger" invisible="active == True"/>
                    <group col="2">
                        <group>
                            <field name="name"/>
                            <field name="company_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="wechat_corp_id"/>
                        </group>
                        <group>
                            <field name="wechat_agent_id"/>
                            <field name="wechat_secret" password="True"/>
                        </group>
                    </group>
                    <group string="网页授权及JS-SDK（H5发布用）">
                        <field name="wechat_js_sdk_file" filename="wechat_js_sdk_file_name"/>
                        <field name="wechat_js_sdk_file_name"/>
                    </group>
                    <group string="备注">
                        <field name="description" nolabel="1" placeholder="可以填写备注信息..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="wechat_app_action">
        <field name="name">企微应用</field>
        <field name="res_model">wechat.app</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
