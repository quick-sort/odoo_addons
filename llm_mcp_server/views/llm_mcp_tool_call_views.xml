<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_llm_mcp_tool_call_list" model="ir.ui.view">
        <field name="name">llm.mcp.tool.call.view.list</field>
        <field name="model">llm.mcp.tool.call</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" />
                <field name="user_id" />
                <field name="tool_name" />
                <field name="is_error" />
                <field name="duration_ms" />
                <field name="session_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_llm_mcp_tool_call_form" model="ir.ui.view">
        <field name="name">llm.mcp.tool.call.view.form</field>
        <field name="model">llm.mcp.tool.call</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id" />
                            <field name="tool_id" />
                            <field name="tool_name" />
                            <field name="session_id" />
                        </group>
                        <group>
                            <field name="create_date" />
                            <field name="duration_ms" />
                            <field name="is_error" />
                        </group>
                    </group>
                    <group string="Arguments">
                        <field name="arguments" widget="json_editor" nolabel="1" />
                    </group>
                    <group string="Result">
                        <field name="result_summary" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_llm_mcp_tool_call_search" model="ir.ui.view">
        <field name="name">llm.mcp.tool.call.view.search</field>
        <field name="model">llm.mcp.tool.call</field>
        <field name="arch" type="xml">
            <search>
                <field name="tool_name" />
                <field name="user_id" />
                <field name="session_id" />
                <filter
            string="Errors"
            name="errors"
            domain="[('is_error', '=', True)]"
          />
                <filter
            string="Successful"
            name="success"
            domain="[('is_error', '=', False)]"
          />
                <separator />
                <group name="group_by">
                    <filter
              string="User"
              name="group_by_user"
              context="{'group_by': 'user_id'}"
            />
                    <filter
              string="Tool"
              name="group_by_tool"
              context="{'group_by': 'tool_name'}"
            />
                    <filter
              string="Date"
              name="group_by_date"
              context="{'group_by': 'create_date:day'}"
            />
                </group>
            </search>
        </field>
    </record>

    <record id="action_llm_mcp_tool_call" model="ir.actions.act_window">
        <field name="name">MCP Tool Calls</field>
        <field name="res_model">llm.mcp.tool.call</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_errors': 0}</field>
    </record>

    <menuitem
    id="menu_llm_mcp_tool_call"
    name="MCP Tool Calls"
    action="action_llm_mcp_tool_call"
    parent="llm.menu_llm_basic"
    sequence="51"
    groups="llm.group_llm_manager"
  />

</odoo>
