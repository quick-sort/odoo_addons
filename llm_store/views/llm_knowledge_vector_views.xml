<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_llm_knowledge_vector_form" model="ir.ui.view">
        <field name="name">llm.knowledge.vector.form</field>
        <field name="model">llm.knowledge.vector</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
            name="action_build"
            string="Build Embeddings"
            type="object"
            class="oe_highlight"
            confirm="This will (re)split, embed and upsert every resource of this vector's chunkset. Continue?"
          />
                    <button
            name="action_drop"
            string="Drop Index"
            type="object"
            class="btn-secondary"
            confirm="This will delete the store-side collection for this vector configuration. Continue?"
          />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Vector Configuration Name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="chunkset_id" options="{'no_create': True}" />
                            <field name="collection_id" readonly="1" />
                            <field
                name="embedding_model_id"
                options="{'no_create': True}"
              />
                            <field name="is_default" widget="boolean_toggle" />
                        </group>
                        <group>
                            <field name="store_id" options="{'no_create': True}" />
                            <field name="dimension" />
                            <field name="vector_count" />
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_llm_knowledge_vector_tree" model="ir.ui.view">
        <field name="name">llm.knowledge.vector.tree</field>
        <field name="model">llm.knowledge.vector</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="chunkset_id" />
                <field name="embedding_model_id" />
                <field name="store_id" />
                <field name="dimension" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="action_llm_knowledge_vector" model="ir.actions.act_window">
        <field name="name">Vector Configurations</field>
        <field name="res_model">llm.knowledge.vector</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
