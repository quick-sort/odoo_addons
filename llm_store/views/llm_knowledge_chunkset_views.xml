<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_llm_knowledge_chunkset_form" model="ir.ui.view">
        <field name="name">llm.knowledge.chunkset.form</field>
        <field name="model">llm.knowledge.chunkset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
            name="action_chunk"
            string="Preview Chunking"
            type="object"
            class="oe_highlight"
          />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
              name="action_view_chunks"
              type="object"
              class="oe_stat_button"
              icon="fa-puzzle-piece"
            >
                            <field
                name="chunk_count"
                widget="statinfo"
                string="Chunks"
              />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Chunkset Name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="collection_id" options="{'no_create': True}" />
                            <field name="splitter_id" options="{'no_create': True}" />
                            <field name="is_default" widget="boolean_toggle" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Vector Configurations">
                            <field name="vector_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="name" />
                                    <field name="embedding_model_id" />
                                    <field name="store_id" />
                                    <field name="dimension" />
                                    <field name="is_default" widget="boolean_toggle" />
                                    <field name="state" readonly="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_llm_knowledge_chunkset_tree" model="ir.ui.view">
        <field name="name">llm.knowledge.chunkset.tree</field>
        <field name="model">llm.knowledge.chunkset</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="collection_id" />
                <field name="splitter_id" />
                <field name="chunk_count" />
                <field name="vector_count" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="action_llm_knowledge_chunkset" model="ir.actions.act_window">
        <field name="name">Chunking Configurations</field>
        <field name="res_model">llm.knowledge.chunkset</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
