<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="llm_store_view_form" model="ir.ui.view">
        <field name="name">llm.store.view.form</field>
        <field name="model">llm.store</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_databases" type="object" class="oe_stat_button" icon="fa-database">
                            <field name="database_count" widget="statinfo" string="Databases" />
                        </button>
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_toggle" options="{'terminology': 'archive'}" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Store Instance Name" /></h1>
                    </div>
                    <group>
                        <group string="Instance">
                            <field name="service" />
                            <field name="connection_uri" placeholder="Administrative service endpoint" />
                            <field name="admin_user" />
                            <field name="api_key" password="True" />
                        </group>
                        <group string="Instance Configuration">
                            <field name="metadata" widget="json_inline" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Databases">
                            <field name="database_ids" nolabel="1" context="{'default_store_id': id}">
                                <list>
                                    <field name="name" />
                                    <field name="knowledge_collection_id" />
                                    <field name="chunkset_id" />
                                    <field name="embedding_model_id" />
                                    <field name="dimension" />
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="llm_store_view_tree" model="ir.ui.view">
        <field name="name">llm.store.view.tree</field>
        <field name="model">llm.store</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="service" />
                <field name="database_count" />
                <field name="active" invisible="1" />
            </list>
        </field>
    </record>

    <record id="llm_store_view_search" model="ir.ui.view">
        <field name="name">llm.store.view.search</field>
        <field name="model">llm.store</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="service" />
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]" />
                <filter string="Service" name="group_by_service" context="{'group_by': 'service'}" />
            </search>
        </field>
    </record>

    <record id="llm_store_action" model="ir.actions.act_window">
        <field name="name">Store Instances</field>
        <field name="res_model">llm.store</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure a vector-store service instance.</p>
            <p>The administrator connection provisions child accounts and multiple isolated knowledge databases.</p>
        </field>
    </record>
</odoo>
