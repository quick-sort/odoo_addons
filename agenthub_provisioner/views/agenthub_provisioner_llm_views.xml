<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="agenthub_provisioner_llm_action" model="ir.actions.act_window">
        <field name="name">LLM Profiles</field>
        <field name="res_model">agenthub.provisioner.llm</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="agenthub_provisioner_llm_view_list" model="ir.ui.view">
        <field name="name">agenthub.provisioner.llm.list</field>
        <field name="model">agenthub.provisioner.llm</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="base_url"/>
                <field name="router_model"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="agenthub_provisioner_llm_view_form" model="ir.ui.view">
        <field name="name">agenthub.provisioner.llm.form</field>
        <field name="model">agenthub.provisioner.llm</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Profile name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="base_url"/>
                            <field name="auth_mode"/>
                            <field name="secret" widget="password"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="router_model"/>
                            <field name="haiku_model"/>
                            <field name="sonnet_model"/>
                            <field name="opus_model"/>
                        </group>
                    </group>
                    <group string="Extra Environment">
                        <field name="extra_env" widget="json" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
