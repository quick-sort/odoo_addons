<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="agenthub_provisioner_host_action" model="ir.actions.act_window">
        <field name="name">Provisioner Hosts</field>
        <field name="res_model">agenthub.provisioner.host</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="agenthub_provisioner_host_view_list" model="ir.ui.view">
        <field name="name">agenthub.provisioner.host.list</field>
        <field name="model">agenthub.provisioner.host</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="driver_type"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'online'"
                       decoration-danger="state == 'error'"/>
                <field name="last_probe_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="agenthub_provisioner_host_view_form" model="ir.ui.view">
        <field name="name">agenthub.provisioner.host.form</field>
        <field name="model">agenthub.provisioner.host</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_probe" type="object" string="Probe"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Host name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="driver_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="last_probe_at"/>
                        </group>
                    </group>
                    <group name="driver_config" string="Driver Configuration"/>
                    <group string="Defaults">
                        <group>
                            <field name="default_image"/>
                            <field name="default_network"/>
                            <field name="default_relay_url"/>
                        </group>
                        <group>
                            <field name="default_env" widget="json"/>
                        </group>
                    </group>
                    <group string="Last Error">
                        <field name="last_error" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="agenthub_provisioner_host_view_search" model="ir.ui.view">
        <field name="name">agenthub.provisioner.host.search</field>
        <field name="model">agenthub.provisioner.host</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="driver_type"/>
                <filter name="active" string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="online" string="Online"
                        domain="[('state', '=', 'online')]"/>
            </search>
        </field>
    </record>

</odoo>
